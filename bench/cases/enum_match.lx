# Enums e match: construção de variante, payload e dispatch.
enum Outcome {
  Ok(Int),
  Err(String)
}

fn classify(n: Int) -> Outcome {
  if (n % 2 == 0) {
    return Outcome.Ok(n)
  }
  return Outcome.Err("odd")
}

var i = 0
var total = 0
while (i < 30000) {
  total = total + match classify(i) {
    Outcome.Ok(v) => v,
    Outcome.Err(e) => 1,
  }
  i = i + 1
}
print(total)
