{
  "name": "loxia",
  "displayName": "Loxia",
  "description": "Loxia: destaque de sintaxe, diagnósticos, formatação, completion e rename via LSP",
  "version": "1.1.0",
  "publisher": "loxia-lang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:loxia",
    "onCommand:loxia.restartServer"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node --check extension.js"
  },
  "contributes": {
    "languages": [
      {
        "id": "loxia",
        "aliases": [
          "Loxia",
          "loxia"
        ],
        "extensions": [
          ".lx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "loxia",
        "scopeName": "source.loxia",
        "path": "./syntaxes/loxia.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "loxia.restartServer",
        "title": "Loxia: reiniciar servidor LSP"
      }
    ],
    "configuration": {
      "title": "Loxia",
      "properties": {
        "loxia.server.path": {
          "type": "string",
          "default": "loxia",
          "description": "Comando do servidor LSP. Para rodar do checkout: python."
        },
        "loxia.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Argumentos do servidor LSP. Do checkout: [\"-m\", \"loxia\", \"lsp\"]."
        },
        "loxia.server.cwd": {
          "type": "string",
          "default": "",
          "description": "Diretório de trabalho do servidor (vazio = o do workspace)."
        }
      }
    }
  }
}
