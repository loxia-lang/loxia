# Classes, `class B(A)` inheritance, `super.init(...)`, implicit `this` and a
# field that does not come from a parameter.
class Animal {
  var name: String
  var sex: String

  fn init(name: String) {
    this.name = name
    this.sex = "M"
  }

  fn speak() -> Nil {
    print(this.name + " makes a sound.")
  }
}

class Dog(Animal) {
  var breed: String

  fn init(name: String, breed: String) {
    super.init(name)
    this.breed = breed
  }

  fn speak() -> Nil {
    print(this.name + " barks.")
  }
}

var rex = Dog("Rex", "mixed-breed")
rex.speak()
print(rex.breed)
print(rex.sex)
