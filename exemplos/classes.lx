# Classes, herança `class B(A)`, `super.init(...)`, `this` implícito e campo
# que não vem de parâmetro.
class Animal {
  var nome: String;
  var sexo: String;
  init(nome: String) {
    this.nome = nome;
    this.sexo = "M";
  }

  falar() -> Nil {
    print(this.nome + " faz um som.");
  }
}

class Cachorro(Animal) {
  var raca: String;
  init(nome: String, raca: String) {
    super.init(nome);
    this.raca = raca;
  }

  falar() -> Nil {
    print(this.nome + " late.");
  }
}

var rex = Cachorro("Rex", "vira-lata");
rex.falar();
print(rex.raca);
print(rex.sexo);
