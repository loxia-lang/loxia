# Quicksort com listas tipadas, indexação, push e for-in.
fn quicksort(xs: List[Int]) -> List[Int] {
  if (len(xs) <= 1) {
    return xs;
  }

  val pivot = xs[0];
  val menores: List[Int] = [];
  val maiores: List[Int] = [];

  var i = 1;
  while (i < len(xs)) {
    if (xs[i] < pivot) {
      menores.push(xs[i]);
    } else {
      maiores.push(xs[i]);
    }
    i = i + 1;
  }

  val ordenados: List[Int] = quicksort(menores);
  ordenados.push(pivot);

  for x in quicksort(maiores) {
    ordenados.push(x);
  }

  return ordenados;
}

val xs: List[Int] = [5, 3, 8, 1, 9, 2, 7, 4, 6];
print quicksort(xs);
