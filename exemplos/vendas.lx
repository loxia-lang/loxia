# Relatório de vendas: CSV → agregação → tabela formatada → JSON.
# Programa de exemplo da stdlib T2 (csv, lists, sets, fmt, json, cli, paths, convert).
import std.cli as cli
import std.convert as convert
import std.csv as csv
import std.fmt as fmt
import std.json as json
import std.lists as lists
import std.paths as paths
from std.sets import Set
import std.strings as strings

val spec = ["flag:detalhado", "option:saida", "positional:entrada"]
val opcoes = cli.parse(["--detalhado", "--saida", "relatorio.json", "vendas.csv"], spec)

print(cli.usage("relatorio", spec))
print("")
print("arquivo: " + (cli.positional(opcoes, "entrada") or "?"))
print("saida:   " + (cli.option(opcoes, "saida") or "?"))
print("ext:     " + paths.ext(cli.option(opcoes, "saida") or ""))

val linhas = csv.parse(
  "produto,categoria,quantidade,preco\n"
    + "caneta,papelaria,10,2.50\n"
    + "caderno,papelaria,3,18.00\n"
    + "cafe,alimentacao,2,15.75\n"
    + "cafe,alimentacao,1,15.75\n"
)
if (linhas == nil) {
  raise RuntimeError("CSV inválido.")
}
val registros = linhas
val cabecalho = registros[0]
print("colunas: " + join(cabecalho, " | "))

val categorias: Set[String] = Set()
val totais: Map[String, Float] = {}
val produtos: List[String] = []
var total = 0.0
var quantidade = 0
var indice = 1
while (indice < len(registros)) {
  val linha = registros[indice]
  val produto = linha[0]
  val categoria = linha[1]
  val unidades = convert.toInt(linha[2]) or 0
  val preco = convert.toFloat(linha[3]) or 0.0
  val subtotal = (unidades as Float) * preco
  categorias.add(categoria)
  if (not lists.contains(produtos, produto)) {
    produtos.push(produto)
  }
  if (totais.has(categoria)) {
    totais[categoria] = totais[categoria] + subtotal
  } else {
    totais[categoria] = subtotal
  }
  total = total + subtotal
  quantidade = quantidade + unidades
  indice = indice + 1
}

fn compararTexto(a: String, b: String) -> Int {
  if (a < b) {
    return -1
  }
  if (a > b) {
    return 1
  }
  return 0
}

print("")
print(fmt.pad("categoria", 14) + fmt.pad("total", 10) + "  participação")
for categoria in lists.sort(categorias.toList(), compararTexto) {
  val valor = totais[categoria]
  print((
    fmt.pad(categoria, 14)
      + fmt.pad(fmt.fixed(valor, 2), 10)
      + "  "
      + fmt.pad(fmt.percent(valor / total, 1), 8)
  ))
}

print("")
print("produtos: " + join(lists.sort(produtos, compararTexto), ", "))
print("itens: " + fmt.commas(quantidade))
print("total: " + fmt.fixed(total, 2))
print("ticket: " + fmt.fixed(total / (quantidade as Float), 2))

val resumo: Map[String, Any] = {}
resumo["arquivo"] = cli.positional(opcoes, "entrada")
resumo["categorias"] = categorias.toList()
resumo["itens"] = quantidade
resumo["total"] = total
resumo["detalhado"] = cli.flag(opcoes, "detalhado")
print("")
print(json.pretty(resumo, 2))
print("assinatura: " + convert.hexEncode(strings.upper("vendas")))
