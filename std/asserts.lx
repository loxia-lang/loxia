# std.asserts — falhas explícitas para testes e contratos (T1).
# A falha é RuntimeError: capturável por `except RuntimeError as e`.

/// Raises `RuntimeError` with `message` when `condition` is false.
fn assert(condition: Bool, message: String = "assertion failed") -> Nil {
  if (not condition) {
    raise RuntimeError(message)
  }
}

/// Raises `RuntimeError` when the two values differ; returns `Nil` on success.
fn assertEq[T](
  actual: T,
  expected: T,
  message: String = "assertEq failed"
) -> Nil {
  if (actual != expected) {
    raise RuntimeError(
      "${message}: expected ${str(expected)}, got ${str(actual)}"
    )
  }
}

/// Returns the value narrowed to a non-nil type, or raises `RuntimeError`.
fn assertNotNil[T](
  value: T?,
  message: String = "expected a non-nil value"
) -> T {
  if (value == nil) {
    raise RuntimeError(message)
  }
  return value
}

/// Raises `RuntimeError` with `message` unconditionally.
fn fail(message: String) -> Nil {
  raise RuntimeError(message)
}
