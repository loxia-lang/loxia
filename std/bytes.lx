# std.bytes — composição sobre `Bytes` (T2): Builder, comparação e endian.
#
# `Bytes` é imutável; o `Builder` é a construção incremental da v1: ele acumula em
# `List[Int]`, então gasta ~28 bytes por byte (documentado) e materializa no `build()`.
# Nada aqui toca o host; o módulo é determinístico e entra no corpus t2.

/// Acumula bytes e materializa um `Bytes` no fim.
class Builder {
  var _bytes: List[Int]

  /// Cria um Builder vazio.
  init() {
    this._bytes = []
  }

  /// Anexa todos os bytes de `data` e devolve o próprio Builder.
  fn push(data: Bytes) -> Builder {
    for byte in data {
      this._bytes.push(byte)
    }
    return this
  }

  /// Anexa um único byte 0..255 e devolve o próprio Builder.
  fn pushByte(value: Int) -> Builder {
    if (value < 0 or value > 255) {
      raise RuntimeError("Builder.pushByte() expects 0..255.")
    }
    this._bytes.push(value)
    return this
  }

  /// Número de bytes acumulados.
  fn len() -> Int {
    return len(this._bytes)
  }

  /// Materializa uma cópia imutável; o Builder continua utilizável.
  fn build() -> Bytes {
    return Bytes.fromList(this._bytes)
  }
}

/// Acumula blocos `Bytes` e materializa um `Bytes` por concatenação balanceada.
///
/// Para montar byte a byte use `Builder`; este evita a `List[Int]` e é indicado para
/// blocos grandes. O `build` copia O(n log k) no total (k = número de blocos), sem
/// manter uma cópia intermediária de todos os bytes; um único bloco é devolvido como
/// está (Bytes é imutável).
class ChunkBuilder {
  var _chunks: List[Bytes]

  /// Cria um ChunkBuilder vazio.
  init() {
    this._chunks = []
  }

  /// Anexa um bloco (blocos vazios são ignorados) e devolve o próprio builder.
  fn push(data: Bytes) -> ChunkBuilder {
    if (len(data) > 0) {
      this._chunks.push(data)
    }
    return this
  }

  /// Número total de bytes acumulados.
  fn len() -> Int {
    var total = 0
    for chunk in this._chunks {
      total = total + len(chunk)
    }
    return total
  }

  /// Materializa os blocos; o builder continua utilizável.
  fn build() -> Bytes {
    var current = this._chunks
    while (len(current) > 1) {
      var next: List[Bytes] = []
      var index = 0
      while (index + 1 < len(current)) {
        next.push(current[index].concat(current[index + 1]))
        index = index + 2
      }
      if (index < len(current)) {
        next.push(current[index])
      }
      current = next
    }
    if (len(current) == 0) {
      return Bytes.empty()
    }
    return current[0]
  }
}

/// Compara dois `Bytes` lexicograficamente: -1, 0 ou 1.
fn compare(left: Bytes, right: Bytes) -> Int {
  var index = 0
  while (index < len(left) and index < len(right)) {
    if (left[index] < right[index]) {
      return -1
    }
    if (left[index] > right[index]) {
      return 1
    }
    index = index + 1
  }
  if (len(left) < len(right)) {
    return -1
  }
  if (len(left) > len(right)) {
    return 1
  }
  return 0
}

/// Encodes `value` (0..65535) as two big-endian bytes.
fn u16be(value: Int) -> Bytes {
  _unsigned(value, 65535, "u16be")
  return Bytes.fromList([value // 256, value % 256])
}

/// Encodes `value` (0..65535) as two little-endian bytes.
fn u16le(value: Int) -> Bytes {
  _unsigned(value, 65535, "u16le")
  return Bytes.fromList([value % 256, value // 256])
}

/// Encodes `value` (0..4294967295) as four big-endian bytes.
fn u32be(value: Int) -> Bytes {
  _unsigned(value, 4294967295, "u32be")
  return Bytes.fromList([
    (value // 16777216) % 256,
    (value // 65536) % 256,
    (value // 256) % 256,
    value % 256
  ])
}

/// Encodes `value` (0..4294967295) as four little-endian bytes.
fn u32le(value: Int) -> Bytes {
  _unsigned(value, 4294967295, "u32le")
  return Bytes.fromList([
    value % 256,
    (value // 256) % 256,
    (value // 65536) % 256,
    (value // 16777216) % 256
  ])
}

/// Encodes the 64-bit two's-complement pattern of `value` as eight big-endian bytes.
fn u64be(value: Int) -> Bytes {
  return Bytes.fromList([
    (value >> 56) & 255,
    (value >> 48) & 255,
    (value >> 40) & 255,
    (value >> 32) & 255,
    (value >> 24) & 255,
    (value >> 16) & 255,
    (value >> 8) & 255,
    value & 255
  ])
}

/// Encodes the 64-bit two's-complement pattern of `value` as eight little-endian bytes.
fn u64le(value: Int) -> Bytes {
  return Bytes.fromList([
    value & 255,
    (value >> 8) & 255,
    (value >> 16) & 255,
    (value >> 24) & 255,
    (value >> 32) & 255,
    (value >> 40) & 255,
    (value >> 48) & 255,
    (value >> 56) & 255
  ])
}

/// Reads a big-endian `u16` at `offset`; `nil` if the two bytes are out of bounds.
fn readU16be(data: Bytes, offset: Int) -> Int? {
  if (offset < 0 or offset > len(data) - 2) {
    return nil
  }
  return (data[offset] << 8) | data[offset + 1]
}

/// Reads a little-endian `u16` at `offset`; `nil` if the two bytes are out of bounds.
fn readU16le(data: Bytes, offset: Int) -> Int? {
  if (offset < 0 or offset > len(data) - 2) {
    return nil
  }
  return data[offset] | (data[offset + 1] << 8)
}

/// Reads a big-endian `u32` at `offset`; `nil` if the four bytes are out of bounds.
fn readU32be(data: Bytes, offset: Int) -> Int? {
  if (offset < 0 or offset > len(data) - 4) {
    return nil
  }
  return (data[offset] << 24) | (data[offset + 1] << 16) |
    (data[offset + 2] << 8) | data[offset + 3]
}

/// Reads a little-endian `u32` at `offset`; `nil` if the four bytes are out of bounds.
fn readU32le(data: Bytes, offset: Int) -> Int? {
  if (offset < 0 or offset > len(data) - 4) {
    return nil
  }
  return data[offset] | (data[offset + 1] << 8) |
    (data[offset + 2] << 16) | (data[offset + 3] << 24)
}

/// Reads a big-endian `u64` at `offset`; `nil` if the eight bytes are out of bounds.
///
/// The result is the 64-bit pattern in an `Int`: a value with the high bit set
/// appears negative, exactly like `u64be`.
fn readU64be(data: Bytes, offset: Int) -> Int? {
  if (offset < 0 or offset > len(data) - 8) {
    return nil
  }
  var value = 0
  for index in 0..8 {
    value = (value << 8) | data[offset + index]
  }
  return value
}

/// Reads a little-endian `u64` at `offset`; `nil` if the eight bytes are out of bounds.
///
/// The high bit appears as a negative `Int`, exactly like `u64le`.
fn readU64le(data: Bytes, offset: Int) -> Int? {
  if (offset < 0 or offset > len(data) - 8) {
    return nil
  }
  var value = 0
  for index in 0..8 {
    value = (value << 8) | data[offset + 7 - index]
  }
  return value
}

fn _unsigned(value: Int, maximum: Int, name: String) -> Nil {
  if (value < 0 or value > maximum) {
    raise RuntimeError(name + "() expects 0.." + str(maximum) + ".")
  }
}
