# std.bytes — composição sobre `Bytes` (T2): Builder, comparação e endian.
#
# `Bytes` é imutável; o `Builder` é a construção incremental da v1: ele acumula em
# `List[Int]`, então gasta ~28 bytes por byte (documentado) e materializa no `build()`.
# Nada aqui toca o host; o módulo é determinístico e entra no corpus t2.

/// Acumula bytes e materializa um `Bytes` no fim.
class Builder {
  var _bytes: List[Int]

  /// Cria um Builder vazio.
  init() {
    this._bytes = []
  }

  /// Anexa todos os bytes de `data` e devolve o próprio Builder.
  fn push(data: Bytes) -> Builder {
    for byte in data {
      this._bytes.push(byte)
    }
    return this
  }

  /// Anexa um único byte 0..255 e devolve o próprio Builder.
  fn pushByte(value: Int) -> Builder {
    if (value < 0 or value > 255) {
      raise RuntimeError("Builder.pushByte() expects 0..255.")
    }
    this._bytes.push(value)
    return this
  }

  /// Número de bytes acumulados.
  fn len() -> Int {
    return len(this._bytes)
  }

  /// Materializa uma cópia imutável; o Builder continua utilizável.
  fn build() -> Bytes {
    return Bytes.fromList(this._bytes)
  }
}

/// Compara dois `Bytes` lexicograficamente: -1, 0 ou 1.
fn compare(left: Bytes, right: Bytes) -> Int {
  var index = 0
  while (index < len(left) and index < len(right)) {
    if (left[index] < right[index]) {
      return -1
    }
    if (left[index] > right[index]) {
      return 1
    }
    index = index + 1
  }
  if (len(left) < len(right)) {
    return -1
  }
  if (len(left) > len(right)) {
    return 1
  }
  return 0
}

/// Encodes `value` (0..65535) as two big-endian bytes.
fn u16be(value: Int) -> Bytes {
  _unsigned(value, 65535, "u16be")
  return Bytes.fromList([value // 256, value % 256])
}

/// Encodes `value` (0..65535) as two little-endian bytes.
fn u16le(value: Int) -> Bytes {
  _unsigned(value, 65535, "u16le")
  return Bytes.fromList([value % 256, value // 256])
}

/// Encodes `value` (0..4294967295) as four big-endian bytes.
fn u32be(value: Int) -> Bytes {
  _unsigned(value, 4294967295, "u32be")
  return Bytes.fromList([
    (value // 16777216) % 256,
    (value // 65536) % 256,
    (value // 256) % 256,
    value % 256
  ])
}

/// Encodes `value` (0..4294967295) as four little-endian bytes.
fn u32le(value: Int) -> Bytes {
  _unsigned(value, 4294967295, "u32le")
  return Bytes.fromList([
    value % 256,
    (value // 256) % 256,
    (value // 65536) % 256,
    (value // 16777216) % 256
  ])
}

/// Encodes the 64-bit two's-complement pattern of `value` as eight big-endian bytes.
fn u64be(value: Int) -> Bytes {
  return Bytes.fromList([
    (value >> 56) & 255,
    (value >> 48) & 255,
    (value >> 40) & 255,
    (value >> 32) & 255,
    (value >> 24) & 255,
    (value >> 16) & 255,
    (value >> 8) & 255,
    value & 255
  ])
}

/// Encodes the 64-bit two's-complement pattern of `value` as eight little-endian bytes.
fn u64le(value: Int) -> Bytes {
  return Bytes.fromList([
    value & 255,
    (value >> 8) & 255,
    (value >> 16) & 255,
    (value >> 24) & 255,
    (value >> 32) & 255,
    (value >> 40) & 255,
    (value >> 48) & 255,
    (value >> 56) & 255
  ])
}

fn _unsigned(value: Int, maximum: Int, name: String) -> Nil {
  if (value < 0 or value > maximum) {
    raise RuntimeError(name + "() expects 0.." + str(maximum) + ".")
  }
}
