# SPDX-License-Identifier: MIT OR Apache-2.0
# std.cli — declarative argument parsing (T2), pure Lox.
#
# A spec is a `List[String]` of `flag:NAME`, `option:NAME` and `positional:NAME`
# entries. `parse` returns `Map[String, Any]`: flags become `Bool`, options and
# positionals become `String` (or `nil` when absent). `--` ends option parsing and
# `--name=value` is accepted. Usage errors (unknown option, missing value, duplicate
# spec name) raise `RuntimeError`.

import std.strings as strings

fn _splitSpec(item: String) -> (String, String) {
  val separator = strings.indexOf(item, ":")
  if (separator <= 0 or separator == len(item) - 1) {
    raise RuntimeError("Invalid CLI spec entry '${item}'.")
  }
  return (substr(item, 0, separator), substr(item, separator + 1, len(item)))
}

/// Parses command-line arguments against a declarative spec into a map.
///
/// `args` is the raw argument list without the program name. `spec` lists
/// `flag:NAME`, `option:NAME` and `positional:NAME` entries; the result contains one
/// key per name. Missing flags are `false`, missing options and positionals are `nil`.
/// Options accept `--name value` and `--name=value`, and `--` switches to
/// positional-only parsing.
///
/// Raises `RuntimeError` for an invalid or duplicate spec entry, an unknown option, a
/// missing option value, or a positional argument that the spec does not declare.
fn parse(args: List[String], spec: List[String]) -> Map[String, Any] {
  val kinds: Map[String, String] = {}
  val positionals: List[String] = []
  for item in spec {
    val entry = _splitSpec(item)
    val kind = entry[0]
    val name = entry[1]
    if (kind != "flag" and kind != "option" and kind != "positional") {
      raise RuntimeError("Unknown CLI spec kind '${kind}'.")
    }
    if (kinds.has(name)) {
      raise RuntimeError("Duplicate CLI spec name '${name}'.")
    }
    kinds[name] = kind
    if (kind == "positional") {
      positionals.push(name)
    }
  }

  val result: Map[String, Any] = {}
  for name in kinds {
    if (kinds[name] == "flag") {
      result[name] = false
    } else {
      result[name] = nil
    }
  }

  var index = 0
  var positionalIndex = 0
  var positionalOnly = false
  while (index < len(args)) {
    val argument = args[index]
    if (not positionalOnly and argument == "--") {
      positionalOnly = true
    } elif (not positionalOnly and strings.startsWith(argument, "--")) {
      val body = substr(argument, 2, len(argument))
      val equals = strings.indexOf(body, "=")
      var name = body
      var inline: String? = nil
      if (equals >= 0) {
        name = substr(body, 0, equals)
        inline = substr(body, equals + 1, len(body))
      }
      if (not kinds.has(name)) {
        raise RuntimeError("Unknown option '--${name}'.")
      }
      val kind = kinds[name]
      if (kind == "flag") {
        if (inline != nil) {
          raise RuntimeError("Flag '--${name}' takes no value.")
        }
        result[name] = true
      } elif (kind == "option") {
        if (inline != nil) {
          result[name] = inline
        } else {
          if (index + 1 >= len(args)) {
            raise RuntimeError("Option '--${name}' needs a value.")
          }
          index = index + 1
          result[name] = args[index]
        }
      } else {
        raise RuntimeError("'--${name}' is positional and takes no '--'.")
      }
    } else {
      if (positionalIndex >= len(positionals)) {
        raise RuntimeError("Unexpected positional argument '${argument}'.")
      }
      result[positionals[positionalIndex]] = argument
      positionalIndex = positionalIndex + 1
    }
    index = index + 1
  }
  return result
}

/// Returns whether a boolean flag was present.
///
/// Returns `false` when `name` is absent or does not hold a `Bool`, so a value from a
/// mismatched spec never raises.
fn flag(parsed: Map[String, Any], name: String) -> Bool {
  if (not parsed.has(name)) {
    return false
  }
  val value = parsed[name]
  if (value is Bool) {
    return value as Bool
  }
  return false
}

/// Returns the value of an option, or `nil` when absent.
///
/// Also returns `nil` when `name` is absent or does not hold a `String`.
fn option(parsed: Map[String, Any], name: String) -> String? {
  if (not parsed.has(name)) {
    return nil
  }
  val value = parsed[name]
  if (value is String) {
    return value as String
  }
  return nil
}

/// Returns a positional argument, or `nil` when absent.
///
/// Positionals are stored as `String` values, so this is equivalent to `option`.
fn positional(parsed: Map[String, Any], name: String) -> String? {
  return option(parsed, name)
}

/// Renders a deterministic usage block from the declared spec.
///
/// The first line is `Usage: <program> [options] <positional>...`; one detail line per
/// spec entry follows, using `--name` for flags and `--name <value>` for options.
fn usage(program: String, spec: List[String]) -> String {
  val parts: List[String] = []
  var header = "Usage: " + program + " [options]"
  for item in spec {
    val entry = _splitSpec(item)
    if (entry[0] == "positional") {
      header = header + " <" + entry[1] + ">"
    }
  }
  parts.push(header)
  for item in spec {
    val entry = _splitSpec(item)
    if (entry[0] == "flag") {
      parts.push("  --" + entry[1])
    } elif (entry[0] == "option") {
      parts.push("  --" + entry[1] + " <value>")
    } else {
      parts.push("  <" + entry[1] + ">")
    }
  }
  return join(parts, "\n")
}
