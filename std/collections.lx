# std.collections — Stack, Queue, Deque and PriorityQueue (T3), pure Lox.
#
# Mutable generic containers built from plain lists. Operations are deterministic and
# preserve the order documented on each method; the "pop" methods return `nil` on an
# empty container instead of raising.

/// Generic LIFO stack backed by a list.
class Stack[T] {
  /// Elements from bottom to top.
  var items: List[T]

  /// Creates an empty stack.
  init() {
    this.items = []
  }

  /// Pushes `value` onto the top.
  fn push(value: T) -> Nil {
    this.items.push(value)
  }

  /// Removes and returns the top, or `nil` when the stack is empty.
  fn pop() -> T? {
    return this.items.pop()
  }

  /// Returns the top without removing it, or `nil` when the stack is empty.
  fn peek() -> T? {
    if (len(this.items) == 0) {
      return nil
    }
    return this.items[len(this.items) - 1]
  }

  /// Returns the number of elements.
  fn len() -> Int {
    return len(this.items)
  }

  /// Returns `true` when the stack has no elements.
  fn isEmpty() -> Bool {
    return len(this.items) == 0
  }

  /// Returns a copy of the elements from top to bottom.
  fn toList() -> List[T] {
    val copy: List[T] = []
    var index = len(this.items) - 1
    while (index >= 0) {
      copy.push(this.items[index])
      index = index - 1
    }
    return copy
  }

  /// Removes every element.
  fn clear() -> Nil {
    while (len(this.items) > 0) {
      this.items.pop()
    }
  }
}

/// Generic FIFO queue backed by a list and a moving head index.
class Queue[T] {
  /// Elements in arrival order; slots before `head` are already consumed.
  var items: List[T]
  /// Index of the next element to dequeue.
  var head: Int

  /// Creates an empty queue.
  init() {
    this.items = []
    this.head = 0
  }

  /// Adds `value` at the back of the queue.
  fn enqueue(value: T) -> Nil {
    this.items.push(value)
  }

  /// Removes and returns the oldest element, or `nil` when the queue is empty.
  fn dequeue() -> T? {
    if (this.head >= len(this.items)) {
      return nil
    }
    val value = this.items[this.head]
    this.head = this.head + 1
    return value
  }

  /// Returns the oldest element without removing it, or `nil` when empty.
  fn peek() -> T? {
    if (this.head >= len(this.items)) {
      return nil
    }
    return this.items[this.head]
  }

  /// Returns the number of live elements; consumed slots are not counted.
  fn len() -> Int {
    return len(this.items) - this.head
  }

  /// Returns `true` when the queue has no elements.
  fn isEmpty() -> Bool {
    return this.head >= len(this.items)
  }

  /// Returns a copy of the elements in dequeue order.
  fn toList() -> List[T] {
    val copy: List[T] = []
    var index = this.head
    while (index < len(this.items)) {
      copy.push(this.items[index])
      index = index + 1
    }
    return copy
  }

  /// Removes every element.
  fn clear() -> Nil {
    this.items = []
    this.head = 0
  }
}

/// Generic double-ended queue backed by two lists.
class Deque[T] {
  /// Front half, with the front element at the end of the list.
  var front: List[T]
  /// Back half, with the back element at the end of the list.
  var back: List[T]

  /// Creates an empty deque.
  init() {
    this.front = []
    this.back = []
  }

  /// Inserts `value` at the front.
  fn pushFront(value: T) -> Nil {
    this.front.push(value)
  }

  /// Inserts `value` at the back.
  fn pushBack(value: T) -> Nil {
    this.back.push(value)
  }

  /// Removes and returns the front element, or `nil` when empty.
  fn popFront() -> T? {
    if (len(this.front) > 0) {
      return this.front.pop()
    }
    if (len(this.back) == 0) {
      return nil
    }
    while (len(this.back) > 0) {
      this.front.push(this.back.pop())
    }
    return this.front.pop()
  }

  /// Removes and returns the back element, or `nil` when empty.
  fn popBack() -> T? {
    if (len(this.back) > 0) {
      return this.back.pop()
    }
    if (len(this.front) == 0) {
      return nil
    }
    while (len(this.front) > 0) {
      this.back.push(this.front.pop())
    }
    return this.back.pop()
  }

  /// Returns the front element without removing it, or `nil` when empty.
  fn peekFront() -> T? {
    if (len(this.front) > 0) {
      return this.front[len(this.front) - 1]
    }
    if (len(this.back) == 0) {
      return nil
    }
    return this.back[0]
  }

  /// Returns the back element without removing it, or `nil` when empty.
  fn peekBack() -> T? {
    if (len(this.back) > 0) {
      return this.back[len(this.back) - 1]
    }
    if (len(this.front) == 0) {
      return nil
    }
    return this.front[0]
  }

  /// Returns the number of elements.
  fn len() -> Int {
    return len(this.front) + len(this.back)
  }

  /// Returns `true` when the deque has no elements.
  fn isEmpty() -> Bool {
    return this.len() == 0
  }

  /// Returns a copy from front to back.
  fn toList() -> List[T] {
    val copy: List[T] = []
    var index = len(this.front) - 1
    while (index >= 0) {
      copy.push(this.front[index])
      index = index - 1
    }
    for item in this.back {
      copy.push(item)
    }
    return copy
  }

  /// Removes every element.
  fn clear() -> Nil {
    this.front = []
    this.back = []
  }
}

/// Min-priority queue backed by a binary heap and an explicit comparator.
class PriorityQueue[T] {
  /// Heap array in partial order.
  var items: List[T]
  /// Comparator: returns `true` when `a` must leave before `b`.
  val less: fn(T, T) -> Bool

  /// Creates an empty queue; `less` defines the priority order.
  init(less: fn(T, T) -> Bool) {
    this.items = []
    this.less = less
  }

  /// Inserts `value` and restores the heap order.
  fn push(value: T) -> Nil {
    this.items.push(value)
    this._siftUp(len(this.items) - 1)
  }

  /// Removes and returns the highest-priority (least) element, or `nil` when empty.
  fn pop() -> T? {
    if (len(this.items) == 0) {
      return nil
    }
    val root = this.items[0]
    val size = len(this.items)
    if (size == 1) {
      this.items.pop()
      return root
    }
    val last = this.items[size - 1]
    this.items.pop()
    this.items[0] = last
    this._siftDown(0)
    return root
  }

  /// Returns the highest-priority element without removing it, or `nil` when empty.
  fn peek() -> T? {
    if (len(this.items) == 0) {
      return nil
    }
    return this.items[0]
  }

  /// Returns the number of elements.
  fn len() -> Int {
    return len(this.items)
  }

  /// Returns `true` when the priority queue has no elements.
  fn isEmpty() -> Bool {
    return len(this.items) == 0
  }

  /// Returns a copy in priority order without modifying the queue.
  fn toList() -> List[T] {
    val result: List[T] = []
    for item in this.items {
      result.push(item)
    }
    var index = 1
    while (index < len(result)) {
      val value = result[index]
      var position = index - 1
      while (position >= 0 and this.less(value, result[position])) {
        result[position + 1] = result[position]
        position = position - 1
      }
      result[position + 1] = value
      index = index + 1
    }
    return result
  }

  /// Removes every element.
  fn clear() -> Nil {
    while (len(this.items) > 0) {
      this.items.pop()
    }
  }

  fn _swap(left: Int, right: Int) -> Nil {
    val value = this.items[left]
    this.items[left] = this.items[right]
    this.items[right] = value
  }

  fn _siftUp(var index: Int) -> Nil {
    while (index > 0) {
      val parent = (index - 1) // 2
      if (this.less(this.items[index], this.items[parent])) {
        this._swap(index, parent)
        index = parent
      } else {
        return
      }
    }
  }

  fn _siftDown(var index: Int) -> Nil {
    val size = len(this.items)
    while (true) {
      val left = index * 2 + 1
      if (left >= size) {
        return
      }
      var smallest = left
      val right = left + 1
      if (right < size and this.less(this.items[right], this.items[left])) {
        smallest = right
      }
      if (this.less(this.items[smallest], this.items[index])) {
        this._swap(index, smallest)
        index = smallest
      } else {
        return
      }
    }
  }
}
