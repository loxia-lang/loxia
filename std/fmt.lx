# std.fmt — deterministic text formatting (T2), pure Lox.
#
# No locale is consulted: `fixed`, `commas` and `bytes` produce the same bytes in every
# environment. `format` is variadic (`format(template, ...values: Any)`, ADR-0083) and
# raises on placeholder/argument mismatches. Invalid domains (negative width, non-finite
# floats) raise `RuntimeError`.

/// Replaces each `{}` placeholder with the next value rendered by `str`.
///
/// `{{` and `}}` produce literal braces. Raises `RuntimeError` for a malformed
/// placeholder (such as a lone `{` or `}`) or when the number of values does not match
/// the number of placeholders.
fn format(template: String, ...values: Any) -> String {
  val parts: List[String] = []
  var index = 0
  var next = 0
  while (index < len(template)) {
    val code = charCodeAt(template, index)
    if (code == 123) {
      if (index + 1 < len(template) and charCodeAt(template, index + 1) == 123) {
        parts.push("{")
        index = index + 2
      } else {
        if (index + 1 >= len(template) or charCodeAt(template, index + 1) != 125) {
          raise RuntimeError("format() expects '{}' placeholders.")
        }
        if (next >= len(values)) {
          raise RuntimeError("format() has too few arguments.")
        }
        parts.push(str(values[next]))
        next = next + 1
        index = index + 2
      }
    } elif (code == 125) {
      if (index + 1 < len(template) and charCodeAt(template, index + 1) == 125) {
        parts.push("}")
        index = index + 2
      } else {
        raise RuntimeError("format() has a stray '}'.")
      }
    } else {
      parts.push(fromCodePoint(code))
      index = index + 1
    }
  }
  if (next != len(values)) {
    raise RuntimeError("format() has too many arguments.")
  }
  return join(parts, "")
}

/// Left-pads `text` to `width` using repeated `fill`.
///
/// `fill` must be exactly one code point. Text that is already at least `width` long is
/// returned unchanged. A negative width or a multi-character fill raises `RuntimeError`.
fn pad(text: String, width: Int, fill: String = " ") -> String {
  if (width < 0) {
    raise RuntimeError("pad() expects a non-negative width.")
  }
  if (len(fill) != 1) {
    raise RuntimeError("pad() expects a one-character fill.")
  }
  if (len(text) >= width) {
    return text
  }
  val parts: List[String] = []
  var count = width - len(text)
  while (count > 0) {
    parts.push(fill)
    count = count - 1
  }
  parts.push(text)
  return join(parts, "")
}

/// Formats an integer with `,` thousands separators.
///
/// Negative values keep a leading `-`; the sign itself is never grouped. `commas(0)` is
/// `"0"` and the output is independent of locale.
fn commas(value: Int) -> String {
  val negative = value < 0
  var rest = value
  val digits: List[String] = []
  if (rest == 0) {
    digits.push("0")
  }
  while (rest != 0) {
    val digit = rest % 10
    if (digit < 0) {
      digits.push(str(-digit))
    } else {
      digits.push(str(digit))
    }
    rest = rest // 10
  }
  val grouped: List[String] = []
  var index = 0
  while (index < len(digits)) {
    if (index > 0 and index % 3 == 0) {
      grouped.push(",")
    }
    grouped.push(digits[index])
    index = index + 1
  }
  val parts: List[String] = []
  index = len(grouped) - 1
  while (index >= 0) {
    parts.push(grouped[index])
    index = index - 1
  }
  if (negative) {
    return "-" + join(parts, "")
  }
  return join(parts, "")
}

fn _isFinite(value: Float) -> Bool {
  if (value != value) {
    return false
  }
  return value <= 1.7976931348623157e308 and value >= -1.7976931348623157e308
}

/// Formats a finite `Float` with exactly `digits` decimal places.
///
/// Rounds with `math.round` and pads the fraction with zeros. `digits` must be in
/// 0..15 and the value must be finite; otherwise `RuntimeError` is raised. With
/// `digits == 0` the result has no decimal point.
fn fixed(value: Float, digits: Int) -> String {
  if (digits < 0 or digits > 15) {
    raise RuntimeError("fixed() expects digits between 0 and 15.")
  }
  if (not _isFinite(value)) {
    raise RuntimeError("fixed() requires a finite Float.")
  }
  val negative = value < 0.0
  var scale = 1
  var index = 0
  while (index < digits) {
    scale = scale * 10
    index = index + 1
  }
  var magnitude = value
  if (negative) {
    magnitude = -value
  }
  val scaled = math.round(magnitude * (scale as Float))
  val whole = scaled // scale
  val fraction = scaled % scale
  var fractionText = str(fraction)
  while (len(fractionText) < digits) {
    fractionText = "0" + fractionText
  }
  if (negative) {
    if (digits == 0) {
      return "-" + str(whole)
    }
    return "-" + str(whole) + "." + fractionText
  }
  if (digits == 0) {
    return str(whole)
  }
  return str(whole) + "." + fractionText
}

/// Formats a value as a percentage with `digits` decimal places.
///
/// Multiplies by 100, formats with `fixed` and appends `%`, so the same digit and
/// finiteness rules apply.
fn percent(value: Float, digits: Int = 0) -> String {
  return fixed(value * 100.0, digits) + "%"
}

/// Formats a byte count with a binary unit (`B`, `KiB`, `MiB`, `GiB` or `TiB`).
///
/// Scales by 1024 and uses one decimal place above `B`. Negative input raises
/// `RuntimeError`; `bytes(0)` is `"0 B"`.
fn bytes(value: Int) -> String {
  if (value < 0) {
    raise RuntimeError("bytes() expects a non-negative size.")
  }
  val units = ["B", "KiB", "MiB", "GiB", "TiB"]
  var divisor = 1
  var unit = 0
  while (unit < 4 and value >= divisor * 1024) {
    divisor = divisor * 1024
    unit = unit + 1
  }
  if (unit == 0) {
    return str(value) + " B"
  }
  return fixed((value as Float) / (divisor as Float), 1) + " " + units[unit]
}
