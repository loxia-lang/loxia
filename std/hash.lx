# std.hash — non-cryptographic hashes over the UTF-8 bytes of text (T3), pure Lox.
#
# Stable, dependency-free hashes intended for indexing and casual checks, not for
# security. Input is expanded to UTF-8 first, so the result is the same in the tree-walk
# and the native backend.

/// Returns the 32-bit FNV-1a hash of the UTF-8 bytes of `text`.
///
/// The result is masked to 0..4294967295, so it is never negative.
fn fnv1a32(text: String) -> Int {
  var hash = 2166136261
  for byte in _utf8Bytes(text) {
    hash = hash ^ byte
    hash = (hash * 16777619) & 4294967295
  }
  return hash
}

/// Returns the 64-bit FNV-1a hash of the UTF-8 bytes of `text`.
///
/// The result is the i64 bit pattern and may be negative; compare it as an `Int`, not
/// as an unsigned value.
fn fnv1a64(text: String) -> Int {
  var hash = -3750763034362895579
  for byte in _utf8Bytes(text) {
    hash = hash ^ byte
    hash = hash * 1099511628211
  }
  return hash
}

/// Returns the 32-bit djb2 hash of the UTF-8 bytes of `text`.
///
/// The result is masked to 0..4294967295, so it is never negative.
fn djb2(text: String) -> Int {
  var hash = 5381
  for byte in _utf8Bytes(text) {
    hash = ((hash << 5) + hash + byte) & 4294967295
  }
  return hash
}

/// Returns the SHA-256 of the UTF-8 bytes of `text` as 64 lowercase hex characters.
///
/// A cryptographic digest (FIPS 180-4) for integrity and content addressing, computed
/// by the kernel primitive `digest.sha256`; deterministic in both engines. It is not a
/// password hash — use a dedicated KDF for secrets.
fn sha256(text: String) -> String {
  return digest.sha256(text)
}

/// Returns the raw 32-byte SHA-256 of `data`.
///
/// The binary counterpart of `sha256`; use `toHex` when a printable digest is needed.
fn sha256Bytes(data: Bytes) -> Bytes {
  return digest.sha256Bytes(data)
}

fn _utf8Bytes(text: String) -> List[Int] {
  val bytes: List[Int] = []
  var index = 0
  while (index < len(text)) {
    val code = charCodeAt(text, index)
    if (code < 128) {
      bytes.push(code)
    } else if (code < 2048) {
      bytes.push(192 | (code >> 6))
      bytes.push(128 | (code & 63))
    } else if (code < 65536) {
      bytes.push(224 | (code >> 12))
      bytes.push(128 | ((code >> 6) & 63))
      bytes.push(128 | (code & 63))
    } else {
      bytes.push(240 | (code >> 18))
      bytes.push(128 | ((code >> 12) & 63))
      bytes.push(128 | ((code >> 6) & 63))
      bytes.push(128 | (code & 63))
    }
    index = index + 1
  }
  return bytes
}
