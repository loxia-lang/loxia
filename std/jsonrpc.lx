# SPDX-License-Identifier: MIT OR Apache-2.0
# std.jsonrpc — JSON-RPC 2.0 envelopes (T3), pure Lox.
#
# Deterministic: no I/O, clock, locale or hash order. Messages are plain
# `Map[String, Any]` values so they serialize with `std.json`. Validation rejects
# batches: LSP does not use them.

import std.json as json

/// A JSON-RPC error: why `decode` rejected a message, or the `error` member of a
/// response. `code` is the JSON-RPC error code and `data` is the optional payload.
///
/// `data` is `Any` because JSON-RPC allows any JSON value; narrow it with `is`/`as`
/// before use (ADR-0144). Envelopes keep insertion order and never include addresses.
class RpcFailure {
  /// Numeric JSON-RPC error code: `-32700` parse, `-32600` invalid request,
  /// `-32601` method not found, `-32602` invalid params, `-32603` internal.
  val code: Int

  /// Human-readable reason; never contains a path, timestamp or address.
  val message: String

  /// Optional JSON payload from `error.data`; `nil` when the error has no data.
  val data: Any

  /// Creates a failure with an explicit code, message and optional data.
  fn init(code: Int, message: String, data: Any = nil) {
    this.code = code
    this.message = message
    this.data = data
  }
}

/// Parses and validates one JSON-RPC 2.0 envelope.
///
/// A request has `method` and `id`; a notification has `method` and no `id`; a response
/// has exactly one of `result` or `error`. `id` is `Int` or `String` in requests, and
/// may also be `nil` in responses. `params` is an array or an object when present.
/// Batches (a top-level array) and malformed JSON are reported as failures.
fn decode(text: String) -> Result[Map[String, Any], RpcFailure] {
  val parsed = json.parseResult(text)
  if (not json.isOk(parsed)) {
    return Result.Err(RpcFailure(-32700, "Parse error"))
  }
  val value = json.value(parsed)
  if (not (value is Map[String, Any])) {
    return _invalid()
  }
  val message = value as Map[String, Any]
  if (not _hasProtocol(message)) {
    return _invalid()
  }
  val hasMethod = message.has("method")
  val hasResult = message.has("result")
  val hasError = message.has("error")
  if (hasMethod) {
    if (hasResult or hasError) {
      return _invalid()
    }
    if (not _validMethod(message["method"])) {
      return _invalid()
    }
    if (message.has("params") and not _validParams(message["params"])) {
      return _invalid()
    }
    if (message.has("id") and not _validRequestId(message["id"])) {
      return _invalid()
    }
    return Result.Ok(message)
  }
  if (hasResult and hasError) {
    return _invalid()
  }
  if (not (hasResult or hasError)) {
    return _invalid()
  }
  if (not message.has("id")) {
    return _invalid()
  }
  if (not _validResponseId(message["id"])) {
    return _invalid()
  }
  if (hasError and not _validError(message["error"])) {
    return _invalid()
  }
  return Result.Ok(message)
}

/// Serializes an envelope as compact JSON, preserving key insertion order.
fn encode(message: Map[String, Any]) -> String {
  return json.stringify(message)
}

/// Builds a request with `method`, an `id` and optional `params`.
///
/// `id` should be an `Int` or a `String`; builders do not validate, `decode` does.
fn request(id: Any, method: String, params: Any = nil) -> Map[String, Any] {
  val message: Map[String, Any] = { "jsonrpc": "2.0", "id": id, "method": method }
  if (params != nil) {
    message["params"] = params
  }
  return message
}

/// Builds a notification: `method` with no `id`.
fn notification(method: String, params: Any = nil) -> Map[String, Any] {
  val message: Map[String, Any] = { "jsonrpc": "2.0", "method": method }
  if (params != nil) {
    message["params"] = params
  }
  return message
}

/// Builds a success response; `result` may be `nil` (serialized as `null`).
fn success(id: Any, result: Any = nil) -> Map[String, Any] {
  val message: Map[String, Any] = { "jsonrpc": "2.0", "id": id, "result": result }
  return message
}

/// Builds an error response; the `error` object carries `code`, `message` and
/// `data` when it is not `nil` (omitted data keeps the envelope compatible).
fn failure(id: Any, code: Int, message: String, data: Any = nil) -> Map[String, Any] {
  val error: Map[String, Any] = { "code": code, "message": message }
  if (data != nil) {
    error["data"] = data
  }
  val envelope: Map[String, Any] = { "jsonrpc": "2.0", "id": id, "error": error }
  return envelope
}

/// Returns `true` when the envelope is a request (has `method` and `id`).
fn isRequest(message: Map[String, Any]) -> Bool {
  return message.has("method") and message.has("id")
}

/// Returns `true` when the envelope is a notification (has `method` and no `id`).
fn isNotification(message: Map[String, Any]) -> Bool {
  return message.has("method") and not message.has("id")
}

/// Returns `true` when the envelope is a response (has `result` or `error`).
fn isResponse(message: Map[String, Any]) -> Bool {
  return message.has("result") or message.has("error")
}

/// Returns `true` when the `id` member is present (its value may be `nil`).
fn hasId(message: Map[String, Any]) -> Bool {
  return message.has("id")
}

/// Returns the `id` member, or `nil` when it is absent.
fn idOf(message: Map[String, Any]) -> Any {
  if (not message.has("id")) {
    return nil
  }
  return message["id"]
}

/// Returns the `method` member, or `nil` when it is absent or not a string.
fn methodOf(message: Map[String, Any]) -> String? {
  if (not message.has("method")) {
    return nil
  }
  val value = message["method"]
  if (not (value is String)) {
    return nil
  }
  return value as String
}

/// Returns the typed `error` member, or `nil` when it is absent or malformed.
///
/// `data` is preserved as `Any`; narrowing it is the caller's job (ADR-0144).
fn errorOf(message: Map[String, Any]) -> RpcFailure? {
  if (not message.has("error")) {
    return nil
  }
  return _typedError(message["error"])
}

fn _invalid() -> Result[Map[String, Any], RpcFailure] {
  return Result.Err(RpcFailure(-32600, "Invalid Request"))
}

fn _hasProtocol(message: Map[String, Any]) -> Bool {
  if (not message.has("jsonrpc")) {
    return false
  }
  val version = message["jsonrpc"]
  if (not (version is String)) {
    return false
  }
  return (version as String) == "2.0"
}

fn _validMethod(value: Any) -> Bool {
  if (not (value is String)) {
    return false
  }
  return (value as String) != ""
}

fn _validParams(value: Any) -> Bool {
  return value is List[Any] or value is Map[String, Any]
}

fn _validRequestId(value: Any) -> Bool {
  return value is Int or value is String
}

fn _validResponseId(value: Any) -> Bool {
  return value == nil or value is Int or value is String
}

fn _validError(value: Any) -> Bool {
  return _typedError(value) != nil
}

/// Validates the `error` member and turns it into its typed form.
fn _typedError(value: Any) -> RpcFailure? {
  if (not (value is Map[String, Any])) {
    return nil
  }
  val error = value as Map[String, Any]
  if (not error.has("code")) {
    return nil
  }
  val code = error["code"]
  if (not (code is Int)) {
    return nil
  }
  if (not error.has("message")) {
    return nil
  }
  val text = error["message"]
  if (not (text is String)) {
    return nil
  }
  var data: Any = nil
  if (error.has("data")) {
    data = error["data"]
  }
  return RpcFailure(code as Int, text as String, data)
}
