# std.lists — operações funcionais básicas (T1), em Lox puro.

/// Returns true when the list has no elements.
fn isEmpty(xs: List[Any]) -> Bool {
  return len(xs) == 0
}

/// Returns the number of elements.
fn length(xs: List[Any]) -> Int {
  return len(xs)
}

/// Applies `f` to each element and returns the results.
fn map[T, U](xs: List[T], f: fn(T) -> U) -> List[U] {
  val result: List[U] = []
  var i = 0
  while (i < len(xs)) {
    result.push(f(xs[i]))
    i = i + 1
  }
  return result
}

/// Returns the elements for which `predicate` is true.
fn filter[T](xs: List[T], predicate: fn(T) -> Bool) -> List[T] {
  val result: List[T] = []
  var i = 0
  while (i < len(xs)) {
    if (predicate(xs[i])) {
      result.push(xs[i])
    }
    i = i + 1
  }
  return result
}

/// Calls `action` for each element and returns `Nil`.
fn each[T](xs: List[T], action: fn(T) -> Nil) -> Nil {
  var i = 0
  while (i < len(xs)) {
    action(xs[i])
    i = i + 1
  }
}

/// Folds the list left-to-right starting from `initial`.
fn fold[T, U](xs: List[T], initial: U, f: fn(U, T) -> U) -> U {
  var acc = initial
  var i = 0
  while (i < len(xs)) {
    acc = f(acc, xs[i])
    i = i + 1
  }
  return acc
}

/// Returns true when at least one element satisfies `predicate`.
fn any[T](xs: List[T], predicate: fn(T) -> Bool) -> Bool {
  var i = 0
  while (i < len(xs)) {
    if (predicate(xs[i])) {
      return true
    }
    i = i + 1
  }
  return false
}

/// Returns true when every element satisfies `predicate`.
fn all[T](xs: List[T], predicate: fn(T) -> Bool) -> Bool {
  var i = 0
  while (i < len(xs)) {
    if (not predicate(xs[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

/// Returns true when no element satisfies `predicate`.
fn none[T](xs: List[T], predicate: fn(T) -> Bool) -> Bool {
  return not any(xs, predicate)
}

/// Returns the first matching index, or -1.
fn findIndex[T](xs: List[T], predicate: fn(T) -> Bool) -> Int {
  var i = 0
  while (i < len(xs)) {
    if (predicate(xs[i])) {
      return i
    }
    i = i + 1
  }
  return -1
}

/// Returns whether the list contains `value`.
fn contains[T](xs: List[T], value: T) -> Bool {
  var i = 0
  while (i < len(xs)) {
    if (xs[i] == value) {
      return true
    }
    i = i + 1
  }
  return false
}

/// Returns the first index of `value`, or -1.
fn indexOf[T](xs: List[T], value: T) -> Int {
  var i = 0
  while (i < len(xs)) {
    if (xs[i] == value) {
      return i
    }
    i = i + 1
  }
  return -1
}

/// Returns a new list in reverse order.
fn reverse[T](xs: List[T]) -> List[T] {
  val result: List[T] = []
  var i = len(xs)
  while (i > 0) {
    result.push(xs[i - 1])
    i = i - 1
  }
  return result
}

/// Returns the first `count` elements.
fn take[T](xs: List[T], count: Int) -> List[T] {
  val result: List[T] = []
  var i = 0
  while (i < len(xs) and i < count) {
    result.push(xs[i])
    i = i + 1
  }
  return result
}

/// Returns the list without its first `count` elements.
fn drop[T](xs: List[T], count: Int) -> List[T] {
  val result: List[T] = []
  var i = count
  if (i < 0) { i = 0 }
  while (i < len(xs)) {
    result.push(xs[i])
    i = i + 1
  }
  return result
}

/// Returns the half-open range `[start, end)`.
fn slice[T](xs: List[T], start: Int, end: Int) -> List[T] {
  val result: List[T] = []
  var begin = start
  var finish = end
  if (begin < 0) { begin = 0 }
  if (finish < begin) { finish = begin }
  if (finish > len(xs)) { finish = len(xs) }
  if (begin > len(xs)) { begin = len(xs) }
  var i = begin
  while (i < finish) {
    result.push(xs[i])
    i = i + 1
  }
  return result
}

/// Returns the sum of all integers.
fn sum(xs: List[Int]) -> Int {
  var total = 0
  var i = 0
  while (i < len(xs)) {
    total = total + xs[i]
    i = i + 1
  }
  return total
}

/// Returns the first element, or `nil` when empty.
fn first[T](xs: List[T]) -> T? {
  if (len(xs) == 0) {
    return nil
  }
  return xs[0]
}

/// Returns the last element, or `nil` when empty.
fn last[T](xs: List[T]) -> T? {
  if (len(xs) == 0) {
    return nil
  }
  return xs[len(xs) - 1]
}

/// Returns the first matching element, or `nil`.
fn find[T](xs: List[T], predicate: fn(T) -> Bool) -> T? {
  var i = 0
  while (i < len(xs)) {
    if (predicate(xs[i])) {
      return xs[i]
    }
    i = i + 1
  }
  return nil
}

/// Reduces the list with `f`, returning `nil` when empty.
fn reduce[T](xs: List[T], f: fn(T, T) -> T) -> T? {
  if (len(xs) == 0) {
    return nil
  }
  var acc = xs[0]
  var i = 1
  while (i < len(xs)) {
    acc = f(acc, xs[i])
    i = i + 1
  }
  return acc
}

/// Returns how many elements satisfy `predicate`.
fn count[T](xs: List[T], predicate: fn(T) -> Bool) -> Int {
  var total = 0
  var i = 0
  while (i < len(xs)) {
    if (predicate(xs[i])) {
      total = total + 1
    }
    i = i + 1
  }
  return total
}

/// Returns the smallest element, or `nil` when empty.
fn min[T: Ord](xs: List[T]) -> T? {
  if (len(xs) == 0) {
    return nil
  }
  var result = xs[0]
  var i = 1
  while (i < len(xs)) {
    if (xs[i] < result) {
      result = xs[i]
    }
    i = i + 1
  }
  return result
}

/// Returns the largest element, or `nil` when empty.
fn max[T: Ord](xs: List[T]) -> T? {
  if (len(xs) == 0) {
    return nil
  }
  var result = xs[0]
  var i = 1
  while (i < len(xs)) {
    if (xs[i] > result) {
      result = xs[i]
    }
    i = i + 1
  }
  return result
}

/// Returns the element at `index`, or `fallback` when out of range.
fn getOr[T](xs: List[T], index: Int, fallback: T) -> T {
  if (index < 0 or index >= len(xs)) {
    return fallback
  }
  return xs[index]
}

/// Returns a new list sorted by the comparator.
fn sort[T](xs: List[T], compare: fn(T, T) -> Int) -> List[T] {
  if (len(xs) <= 1) {
    return slice(xs, 0, len(xs))
  }
  val middle = len(xs) // 2
  val left = sort(slice(xs, 0, middle), compare)
  val right = sort(slice(xs, middle, len(xs)), compare)
  val result: List[T] = []
  var i = 0
  var j = 0
  while (i < len(left) and j < len(right)) {
    if (compare(left[i], right[j]) <= 0) {
      result.push(left[i])
      i = i + 1
    } else {
      result.push(right[j])
      j = j + 1
    }
  }
  while (i < len(left)) {
    result.push(left[i])
    i = i + 1
  }
  while (j < len(right)) {
    result.push(right[j])
    j = j + 1
  }
  return result
}

/// Returns a new list sorted by natural ordering.
fn sortNatural[T: Ord](xs: List[T]) -> List[T] {
  if (len(xs) <= 1) {
    return slice(xs, 0, len(xs))
  }
  val middle = len(xs) // 2
  val left = sortNatural(slice(xs, 0, middle))
  val right = sortNatural(slice(xs, middle, len(xs)))
  val result: List[T] = []
  var i = 0
  var j = 0
  while (i < len(left) and j < len(right)) {
    if (left[i] <= right[j]) {
      result.push(left[i])
      i = i + 1
    } else {
      result.push(right[j])
      j = j + 1
    }
  }
  while (i < len(left)) {
    result.push(left[i])
    i = i + 1
  }
  while (j < len(right)) {
    result.push(right[j])
    j = j + 1
  }
  return result
}

/// Pairs elements from both lists, stopping at the shorter one.
fn zip[T, U](xs: List[T], ys: List[U]) -> List[(T, U)] {
  val result: List[(T, U)] = []
  var i = 0
  while (i < len(xs) and i < len(ys)) {
    result.push((xs[i], ys[i]))
    i = i + 1
  }
  return result
}

/// Concatenates a list of lists.
fn flatten[T](xs: List[List[T]]) -> List[T] {
  val result: List[T] = []
  for inner in xs {
    for item in inner {
      result.push(item)
    }
  }
  return result
}

/// Maps each element to a list and concatenates the results.
fn flatMap[T, U](xs: List[T], f: fn(T) -> List[U]) -> List[U] {
  val result: List[U] = []
  var i = 0
  while (i < len(xs)) {
    for item in f(xs[i]) {
      result.push(item)
    }
    i = i + 1
  }
  return result
}

/// Returns the elements without duplicates, preserving order.
fn unique[T](xs: List[T]) -> List[T] {
  val result: List[T] = []
  for item in xs {
    if (not contains(result, item)) {
      result.push(item)
    }
  }
  return result
}

/// Splits the list into chunks of at most `size` elements.
fn chunk[T](xs: List[T], size: Int) -> List[List[T]] {
  val result: List[List[T]] = []
  if (size <= 0) {
    return result
  }
  var i = 0
  while (i < len(xs)) {
    result.push(slice(xs, i, i + size))
    i = i + size
  }
  return result
}

/// Splits the list into `(matching, rest)`.
fn partition[T](xs: List[T], predicate: fn(T) -> Bool) -> (List[T], List[T]) {
  val yes: List[T] = []
  val no: List[T] = []
  for item in xs {
    if (predicate(item)) {
      yes.push(item)
    } else {
      no.push(item)
    }
  }
  return (yes, no)
}
