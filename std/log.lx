# SPDX-License-Identifier: MIT OR Apache-2.0
# std.log — leveled logging to stderr, without timestamps (T3), pure Lox.
#
# Output is `[LEVEL] message` on stderr and is deterministic: no timestamps, paths or
# locale-dependent names. Each `Logger` owns its minimum level, so several loggers can
# coexist in one program.

/// Log level; the order is `Debug < Info < Warn < Error`.
enum Level {
  /// Diagnostic detail.
  Debug,
  /// Normal event.
  Info,
  /// Suspicious situation.
  Warn,
  /// Failure.
  Error
}

/// Logger that writes to stderr and filters out levels below `minimum`.
class Logger {
  /// Lowest level that will be written.
  var minimum: Level

  /// Creates a logger; without an argument the minimum is `Level.Info`.
  ///
  /// Passing `nil` selects the same default.
  init(minimum: Level? = nil) {
    this.minimum = minimum ?? Level.Info
  }

  /// Changes the minimum level; lower levels are suppressed from then on.
  fn setMinimum(level: Level) -> Nil {
    this.minimum = level
  }

  /// Writes `[LEVEL] message` to stderr when `level >= minimum`.
  ///
  /// Filtering never raises and does not affect stdout or the exit code.
  fn log(level: Level, message: String) -> Nil {
    if (_rank(level) < _rank(this.minimum)) {
      return
    }
    io.writeErr("[${_name(level)}] ${message}\n")
  }

  /// Logs at `Debug`.
  fn debug(message: String) -> Nil {
    this.log(Level.Debug, message)
  }

  /// Logs at `Info`.
  fn info(message: String) -> Nil {
    this.log(Level.Info, message)
  }

  /// Logs at `Warn`.
  fn warn(message: String) -> Nil {
    this.log(Level.Warn, message)
  }

  /// Logs at `Error`.
  fn error(message: String) -> Nil {
    this.log(Level.Error, message)
  }
}

fn _rank(level: Level) -> Int {
  return match level {
    Level.Debug => 0
    Level.Info => 1
    Level.Warn => 2
    Level.Error => 3
  }
}

fn _name(level: Level) -> String {
  return match level {
    Level.Debug => "DEBUG"
    Level.Info => "INFO"
    Level.Warn => "WARN"
    Level.Error => "ERROR"
  }
}
