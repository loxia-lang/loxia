# std.numeric — integers and statistics (T1), pure Lox.
#
# Invalid domains raise `RuntimeError`; statistics return `nil` for an empty list. The
# variance is population variance (divides by n). Integer arithmetic follows the language
# rules, so `Int` products wrap on overflow outside `--debug`.

import std.lists as lists

fn _abs(value: Int) -> Int {
  if (value < 0) {
    return -value
  }
  return value
}

fn _compareInt(left: Int, right: Int) -> Int {
  if (left < right) {
    return -1
  }
  if (left > right) {
    return 1
  }
  return 0
}

/// Returns the non-negative greatest common divisor.
///
/// Signs are ignored and `gcd(0, 0)` is 0.
fn gcd(left: Int, right: Int) -> Int {
  var a = _abs(left)
  var b = _abs(right)
  while (b != 0) {
    val rest = a % b
    a = b
    b = rest
  }
  return a
}

/// Returns the non-negative least common multiple.
///
/// Returns 0 when either argument is 0; a large product can wrap like any `Int` product.
fn lcm(left: Int, right: Int) -> Int {
  if (left == 0 or right == 0) {
    return 0
  }
  val divisor = gcd(left, right)
  return _abs((left // divisor) * right)
}

/// Returns whether the integer is prime.
///
/// Values below 2 are not prime; 2 is prime and larger even numbers are rejected early.
fn isPrime(value: Int) -> Bool {
  if (value < 2) {
    return false
  }
  if (value == 2) {
    return true
  }
  if (value % 2 == 0) {
    return false
  }
  var candidate = 3
  while (candidate <= value // candidate) {
    if (value % candidate == 0) {
      return false
    }
    candidate = candidate + 2
  }
  return true
}

/// Returns all primes up to and including `limit`, in ascending order.
///
/// `limit < 2` yields `[]`.
fn primes(limit: Int) -> List[Int] {
  val result: List[Int] = []
  var value = 2
  while (value <= limit) {
    if (isPrime(value)) {
      result.push(value)
    }
    value = value + 1
  }
  return result
}

/// Returns `value!`.
///
/// Negative input raises `RuntimeError`; an overflowing result wraps like any `Int`
/// product.
fn factorial(value: Int) -> Int {
  if (value < 0) {
    raise RuntimeError("factorial() expects a non-negative integer.")
  }
  var result = 1
  var factor = 2
  while (factor <= value) {
    result = result * factor
    factor = factor + 1
  }
  return result
}

/// Returns `base ** exponent` modulo `modulus`.
///
/// `modulus` must be positive and `exponent` non-negative, otherwise `RuntimeError` is
/// raised. A negative `base` is normalized before the modular arithmetic.
fn powMod(base: Int, exponent: Int, modulus: Int) -> Int {
  if (modulus <= 0) {
    raise RuntimeError("powMod() expects a positive modulus.")
  }
  if (exponent < 0) {
    raise RuntimeError("powMod() expects a non-negative exponent.")
  }
  var result = 1 % modulus
  var factor = ((base % modulus) + modulus) % modulus
  var power = exponent
  while (power > 0) {
    if (power % 2 == 1) {
      result = (result * factor) % modulus
    }
    power = power // 2
    factor = (factor * factor) % modulus
  }
  return result
}

/// Returns the sum of the decimal digits.
///
/// The sign is ignored, so `digitSum(-42)` is 6; `digitSum(0)` is 0.
fn digitSum(value: Int) -> Int {
  var rest = value
  var total = 0
  while (rest != 0) {
    var digit = rest % 10
    if (digit < 0) {
      digit = -digit
    }
    total = total + digit
    rest = rest // 10
  }
  return total
}

/// Returns whether the integer is even. Negative values follow the same parity rule.
fn isEven(value: Int) -> Bool {
  return value % 2 == 0
}

/// Returns whether the integer is odd. Negative values follow the same parity rule.
fn isOdd(value: Int) -> Bool {
  return value % 2 != 0
}

/// Returns -1, 0 or 1 according to the sign.
fn sign(value: Int) -> Int {
  if (value < 0) {
    return -1
  }
  if (value > 0) {
    return 1
  }
  return 0
}

/// Returns the arithmetic mean as `Float`, or `nil` for an empty list.
fn mean(values: List[Int]) -> Float? {
  if (len(values) == 0) {
    return nil
  }
  var total = 0.0
  for value in values {
    total = total + (value as Float)
  }
  return total / len(values)
}

/// Returns the median as `Float`, or `nil` for an empty list.
///
/// A copy is sorted, so the input list is not modified. For an even length the two
/// middle values are averaged.
fn median(values: List[Int]) -> Float? {
  if (len(values) == 0) {
    return nil
  }
  val copy = lists.slice(values, 0, len(values))
  val sorted = lists.sort(copy, _compareInt)
  val middle = len(sorted) // 2
  if (len(sorted) % 2 == 1) {
    return sorted[middle] as Float
  }
  return ((sorted[middle - 1] as Float) + (sorted[middle] as Float)) / 2.0
}

/// Returns the most frequent value, or `nil` for an empty list.
///
/// Ties keep the value that first reaches the highest count in list order.
fn mode(values: List[Int]) -> Int? {
  if (len(values) == 0) {
    return nil
  }
  var best = values[0]
  var bestCount = 0
  for candidate in values {
    var count = 0
    for item in values {
      if (item == candidate) {
        count = count + 1
      }
    }
    if (count > bestCount) {
      best = candidate
      bestCount = count
    }
  }
  return best
}

/// Returns the population variance, or `nil` for an empty list.
///
/// Divides by n, not by n-1.
fn variance(values: List[Int]) -> Float? {
  val average = mean(values)
  if (average == nil) {
    return nil
  }
  var total = 0.0
  for value in values {
    val difference = (value as Float) - average
    total = total + difference * difference
  }
  return total / len(values)
}

/// Returns the population standard deviation, or `nil` for an empty list.
///
/// Square root of `variance`.
fn stddev(values: List[Int]) -> Float? {
  val spread = variance(values)
  if (spread == nil) {
    return nil
  }
  return math.sqrt(spread)
}

/// Rounds to `digits` decimal places.
///
/// Negative digits are allowed and round to tens, hundreds and so on, because the scale
/// is `10.0 ** digits`.
fn roundTo(value: Float, digits: Int) -> Float {
  val factor = 10.0 ** digits
  return (math.round(value * factor) as Float) / factor
}

fn _digitChar(digit: Int) -> String {
  return substr("0123456789abcdefghijklmnopqrstuvwxyz", digit, digit + 1)
}

/// Formats an integer in base 2..36 using lowercase digits.
///
/// Negative values keep a leading `-`; an invalid base raises `RuntimeError`.
fn toBase(value: Int, base: Int) -> String {
  if (base < 2 or base > 36) {
    raise RuntimeError("toBase() expects a base between 2 and 36.")
  }
  if (value == 0) {
    return "0"
  }
  val negative = value < 0
  var rest = value
  var result = ""
  while (rest != 0) {
    var digit = rest % base
    if (digit < 0) {
      digit = -digit
    }
    result = _digitChar(digit) + result
    rest = rest // base
  }
  if (negative) {
    return "-" + result
  }
  return result
}

fn _digitValue(code: Int) -> Int {
  if (code >= 48 and code <= 57) {
    return code - 48
  }
  if (code >= 65 and code <= 90) {
    return code - 65 + 10
  }
  if (code >= 97 and code <= 122) {
    return code - 97 + 10
  }
  return -1
}

/// Parses an integer in base 2..36, returning `nil` when invalid.
///
/// Accepts an optional `+`/`-` and lowercase or uppercase digits. An invalid base raises
/// `RuntimeError`; invalid digits or an empty string return `nil`.
fn fromBase(text: String, base: Int) -> Int? {
  if (base < 2 or base > 36) {
    raise RuntimeError("fromBase() expects a base between 2 and 36.")
  }
  if (len(text) == 0) {
    return nil
  }
  var index = 0
  var negative = false
  val first = charCodeAt(text, 0)
  if (first == 45 or first == 43) {
    negative = first == 45
    index = 1
    if (len(text) == 1) {
      return nil
    }
  }
  var result = 0
  while (index < len(text)) {
    val digit = _digitValue(charCodeAt(text, index))
    if (digit < 0 or digit >= base) {
      return nil
    }
    result = result * base + digit
    index = index + 1
  }
  if (negative) {
    return -result
  }
  return result
}
