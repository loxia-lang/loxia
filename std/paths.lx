# SPDX-License-Identifier: MIT OR Apache-2.0
# std.paths — lexical POSIX path helpers (T2), pure Lox.
#
# Text-only: these functions never touch the filesystem and always use `/` as the
# separator. `joinPath` only concatenates components; call `normalize` to collapse
# repeated separators and resolve `.`/`..` lexically. Operations are deterministic:
# the same input produces the same output in the tree-walk and the native backend.

import std.contracts as contracts
import std.strings as strings

/// Returns whether the POSIX path is absolute.
///
/// A path is absolute when its first code point is `/`; the empty string is relative.
fn isAbsolute(path: String) -> Bool {
  return len(path) > 0 and charCodeAt(path, 0) == 47
}

/// Splits a POSIX path into components.
///
/// Splits on `/` and drops empty components, so repeated and leading/trailing
/// separators disappear: `split("/a//b/")` is `["a", "b"]` and `split("")` is `[]`.
fn split(path: String) -> List[String] {
  val result: List[String] = []
  for part in strings.split(path, "/") {
    if (len(part) > 0) {
      result.push(part)
    }
  }
  return result
}

/// Joins a base path and a child path with a single `/` separator.
///
/// An absolute `child` (or an empty `base`) wins and is returned unchanged. An empty
/// `child` returns `base`. This is a lexical join: `.` and `..` are not resolved and
/// separators already present in `child` are preserved.
fn joinPath(base: String, child: String) -> String {
  if (len(child) == 0) {
    return base
  }
  if (len(base) == 0 or isAbsolute(child)) {
    return child
  }
  if (charCodeAt(base, len(base) - 1) == 47) {
    return base + child
  }
  return base + "/" + child
}

fn _stripTrailing(path: String) -> String {
  var end = len(path)
  while (end > 1 and charCodeAt(path, end - 1) == 47) {
    end = end - 1
  }
  return substr(path, 0, end)
}

fn _joinParts(parts: List[String]) -> String {
  var result = ""
  var index = 0
  while (index < len(parts)) {
    if (index > 0) {
      result = result + "/"
    }
    result = result + parts[index]
    index = index + 1
  }
  return result
}

/// Returns the final path component.
///
/// Trailing separators are ignored. `/` is its own basename and the empty path maps
/// to `.`; `basename("a/b/")` is `"b"`.
fn basename(path: String) -> String {
  if (len(path) == 0) {
    return "."
  }
  val trimmed = _stripTrailing(path)
  if (len(trimmed) == 1 and charCodeAt(trimmed, 0) == 47) {
    return "/"
  }
  var index = len(trimmed) - 1
  while (index >= 0) {
    if (charCodeAt(trimmed, index) == 47) {
      return substr(trimmed, index + 1, len(trimmed))
    }
    index = index - 1
  }
  return trimmed
}

/// Returns the parent path without a trailing separator.
///
/// `dirname("/a")` is `/`, `dirname("a")` and the empty path are `.`. The result is
/// lexical: no filesystem lookup or symlink resolution happens.
fn dirname(path: String) -> String {
  if (len(path) == 0) {
    return "."
  }
  val trimmed = _stripTrailing(path)
  var index = len(trimmed) - 1
  while (index >= 0) {
    if (charCodeAt(trimmed, index) == 47) {
      if (index == 0) {
        return "/"
      }
      return _stripTrailing(substr(trimmed, 0, index))
    }
    index = index - 1
  }
  return "."
}

/// Returns the file extension of the final component, without the leading dot.
///
/// `ext("a/b.tar.gz")` is `"gz"`; a dotfile such as `.bashrc` has no extension, and a
/// missing extension returns `""`.
fn ext(path: String) -> String {
  val name = basename(path)
  var index = len(name) - 1
  while (index > 0) {
    if (charCodeAt(name, index) == 46) {
      return substr(name, index + 1, len(name))
    }
    index = index - 1
  }
  return ""
}

/// Returns the final component without its extension.
///
/// `stem("a/b.tar.gz")` is `"b.tar"`; a name without an extension is returned
/// unchanged, and dotfiles such as `.bashrc` keep their leading dot.
fn stem(path: String) -> String {
  val name = basename(path)
  val suffix = ext(name)
  if (len(suffix) == 0) {
    return name
  }
  return substr(name, 0, len(name) - len(suffix) - 1)
}

/// Resolves `.` and `..` lexically, collapsing repeated separators.
///
/// Absolute paths keep their leading `/`; `..` above a relative root is preserved, so
/// `normalize("a/../..")` is `".."`. The empty path normalizes to `.`. No filesystem
/// access and no symlink resolution: the result depends only on the input text.
fn normalize(path: String) -> String {
  val result = _normalize(path)
  contracts.ensure(
    isAbsolute(result) == isAbsolute(path),
    "normalize: absoluteness changed"
  )
  contracts.ensure(_isNormalized(result), "normalize: unresolved path segment")
  return result
}

fn _normalize(path: String) -> String {
  if (len(path) == 0) {
    return "."
  }
  val absolute = isAbsolute(path)
  val stack: List[String] = []
  for part in split(path) {
    if (part != ".") {
      if (part == "..") {
        if (len(stack) > 0 and stack[len(stack) - 1] != "..") {
          stack.pop()
        } elif (not absolute) {
          stack.push("..")
        }
      } else {
        stack.push(part)
      }
    }
  }
  if (absolute) {
    if (len(stack) == 0) {
      return "/"
    }
    return "/" + _joinParts(stack)
  }
  if (len(stack) == 0) {
    return "."
  }
  return _joinParts(stack)
}

fn _isNormalized(path: String) -> Bool {
  if (path == "." or path == "/") {
    return true
  }
  val absolute = isAbsolute(path)
  var seenSegment = false
  for part in split(path) {
    if (part == "" or part == ".") {
      return false
    }
    if (part == "..") {
      if (absolute or seenSegment) {
        return false
      }
    } else {
      seenSegment = true
    }
  }
  return true
}
