# std.proc — processes and streams (T2, ambient: outside I1/I3), thin Lox shell.
#
# Wraps `proc.*`: no shell and no threads; `poll` is the concurrency primitive. Handles
# are opaque ids that must be closed explicitly, and `run` can block when writing more
# than the pipe buffer (~64 KiB) to a child that is not reading.

/// Byte stream of a child process (`stdin`, `stdout` or `stderr`).
class Stream {
  /// Stream handle used by `proc.*`.
  val id: Int

  /// Wraps an existing stream handle.
  init(id: Int) {
    this.id = id
  }

  /// Reads up to `n` bytes, or `nil` at end of stream.
  ///
  /// Reading stops at a UTF-8 boundary, so the returned text is always valid even when
  /// `n` lands inside a multi-byte code point.
  fn read(n: Int) -> String? {
    return process.read(this.id, n)
  }

  /// Writes all text, returning `false` when the other side closed the pipe.
  fn write(text: String) -> Bool {
    return process.write(this.id, text)
  }

  /// Closes the descriptor; using the stream afterwards is an error.
  ///
  /// Close each handle once: a second close raises for an unknown handle.
  fn close() -> Nil {
    process.close(this.id)
  }
}

/// Child process with its three channels connected to pipes.
class Process {
  /// Process handle used by `proc.*`.
  val id: Int
  /// Child's standard input.
  val stdin: Stream
  /// Child's standard output.
  val stdout: Stream
  /// Child's standard error.
  val stderr: Stream

  /// Wraps an already-started process handle; prefer `spawn`.
  init(id: Int) {
    this.id = id
    this.stdin = Stream(process.stdin(id))
    this.stdout = Stream(process.stdout(id))
    this.stderr = Stream(process.stderr(id))
  }

  /// Waits for the process to exit and returns its status.
  ///
  /// A negative status means the child was terminated by a signal.
  fn wait() -> Int {
    return process.wait(this.id)
  }

  /// Sends `SIGKILL`, returning `false` when the process already exited.
  fn kill() -> Bool {
    return process.kill(this.id)
  }

  /// Closes the channels and releases the handle.
  ///
  /// Does not kill a process that is still running; call `kill` first if needed.
  fn close() -> Nil {
    process.close(this.id)
  }
}

/// Captured output of a finished `run`.
class Output {
  /// Exit code (negative when the child died from a signal).
  val code: Int
  /// Everything the child wrote to stdout.
  val stdout: String
  /// Everything the child wrote to stderr.
  val stderr: String

  /// Builds the result of a finished run.
  init(code: Int, stdout: String, stderr: String) {
    this.code = code
    this.stdout = stdout
    this.stderr = stderr
  }
}

/// Starts `argv` without a shell, with pipes on all three channels.
///
/// Returns `nil` when the process cannot be started. `argv[0]` is resolved by the OS,
/// not by a shell, so no quoting or command interpolation happens.
fn spawn(argv: List[String]) -> Process? {
  val id = process.spawn(argv)
  if (id == 0) {
    return nil
  }
  return Process(id)
}

/// Runs `argv` to completion and returns its exit code and captured output.
///
/// `stdin` is written before the first `poll` (practical limit: the pipe buffer,
/// ~64 KiB; larger text can block if the child does not read). `timeoutMs > 0` kills the
/// process and returns `nil`. There is no shell and no command interpolation; `nil` also
/// means the process could not be started.
fn run(argv: List[String], stdin: String = "", timeoutMs: Int = 0) -> Output? {
  val child = spawn(argv)
  if (child == nil) {
    return nil
  }
  if (stdin != "") {
    child.stdin.write(stdin)
  }
  child.stdin.close()

  val outId = child.stdout.id
  val errId = child.stderr.id
  val outParts: List[String] = []
  val errParts: List[String] = []
  var outOpen = true
  var errOpen = true
  var done = false
  var code = 0
  var deadline = 0
  if (timeoutMs > 0) {
    deadline = time.now() + timeoutMs
  }

  while (not done or outOpen or errOpen) {
    val handles: List[Int] = []
    if (not done) {
      handles.push(child.id)
    }
    if (outOpen) {
      handles.push(outId)
    }
    if (errOpen) {
      handles.push(errId)
    }
    var timeout = -1
    if (deadline != 0) {
      timeout = deadline - time.now()
      if (timeout < 0) {
        timeout = 0
      }
    }
    val ready = process.poll(handles, timeout)
    if (len(ready) == 0) {
      child.kill()
      child.wait()
      child.close()
      return nil
    }
    for id in ready {
      if (id == child.id) {
        code = child.wait()
        done = true
      } else if (id == outId) {
        val chunk = child.stdout.read(4096)
        if (chunk == nil) {
          outOpen = false
        } else {
          outParts.push(chunk)
        }
      } else if (id == errId) {
        val chunk = child.stderr.read(4096)
        if (chunk == nil) {
          errOpen = false
        } else {
          errParts.push(chunk)
        }
      }
    }
  }
  child.close()
  return Output(code, join(outParts, ""), join(errParts, ""))
}
