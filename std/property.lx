# std.property — property-based testing determinístico (T3), em Lox puro.
import std.strings as strings
from std.rand import Rand
from std.test import Skip, TestFailure

/// Gerador de valores com estratégia de geração e de redução (shrinking).
class Gen[T] {
  /// Produz um valor a partir do gerador aleatório.
  val generate: fn(Rand) -> T
  /// Candidatos menores que `value` (lista vazia = não reduz).
  val shrink: fn(T) -> List[T]

  /// Cria o gerador com as duas funções.
  init(generate: fn(Rand) -> T, shrink: fn(T) -> List[T]) {
    this.generate = generate
    this.shrink = shrink
  }

  /// Amostra um valor.
  fn sample(random: Rand) -> T {
    return this.generate(random)
  }

  /// Candidatos menores para o shrinking.
  fn smaller(value: T) -> List[T] {
    return this.shrink(value)
  }
}

/// Executa `check` com `runs` valores; falha com contraexemplo reduzido e seed.
fn forAll[T](
  generator: Gen[T],
  check: fn(T) -> Nil,
  runs: Int = 100,
  seed: Int = 0
) -> Nil {
  val random = Rand(seed)
  var attempt = 0
  while (attempt < runs) {
    val value = generator.sample(random)
    var failure = ""
    var failed = false
    try {
      check(value)
    } except Skip as _skip {
      raise _skip
    } except Exception as _error {
      failed = true
      failure = _error.message
    }
    if (failed) {
      val shrunk = _shrink(generator, value, check)
      if (shrunk == value) {
        raise TestFailure(
          "property failed after ${attempt + 1} run(s) (seed ${seed}): " +
          "${failure}; counterexample ${repr(value)}"
        )
      }
      raise TestFailure(
        "property failed after ${attempt + 1} run(s) (seed ${seed}): " +
        "${failure}; counterexample ${repr(value)}; shrunk to ${repr(shrunk)}"
      )
    }
    attempt = attempt + 1
  }
}

/// Inteiro de 64 bits; reduz para 0 e para a metade.
fn int() -> Gen[Int] {
  return Gen(
    fn(random: Rand) -> Int { return random.nextInt() },
    fn(value: Int) -> List[Int] {
      if (value == 0) { return [] }
      val candidates = [0]
      val half = value // 2
      if (half != 0 and half != value) {
        candidates.push(half)
      }
      return candidates
    }
  )
}

/// Inteiro em `[min, max]`; reduz na direção de `min`.
fn intRange(min: Int, max: Int) -> Gen[Int] {
  return Gen(
    fn(random: Rand) -> Int { return random.int(min, max) },
    fn(value: Int) -> List[Int] {
      if (value == min) { return [] }
      val candidates = [min]
      val half = min + (value - min) // 2
      if (half != min and half != value) {
        candidates.push(half)
      }
      return candidates
    }
  )
}

/// `Bool`; reduz `true` para `false`.
fn bool() -> Gen[Bool] {
  return Gen(
    fn(random: Rand) -> Bool { return random.bool() },
    fn(value: Bool) -> List[Bool] {
      if (value) { return [false] }
      return []
    }
  )
}

/// `Float` em `[0.0, 1.0)`; reduz para `0.0`.
fn float() -> Gen[Float] {
  return Gen(
    fn(random: Rand) -> Float { return random.float() },
    fn(value: Float) -> List[Float] {
      if (value == 0.0) { return [] }
      return [0.0]
    }
  )
}

/// Lista de `T` com tamanho em `[0, maxLength]`; reduz removendo elementos.
fn listOf[T](element: Gen[T], maxLength: Int = 5) -> Gen[List[T]] {
  return Gen(
    fn(random: Rand) -> List[T] {
      val result: List[T] = []
      val size = random.int(0, maxLength)
      var index = 0
      while (index < size) {
        result.push(element.sample(random))
        index = index + 1
      }
      return result
    },
    fn(value: List[T]) -> List[List[T]] {
      val candidates: List[List[T]] = []
      var index = 0
      while (index < len(value)) {
        val smaller: List[T] = []
        var current = 0
        while (current < len(value)) {
          if (current != index) {
            smaller.push(value[current])
          }
          current = current + 1
        }
        candidates.push(smaller)
        index = index + 1
      }
      return candidates
    }
  )
}

/// Lista de `Int`; alias de `listOf` mantido para compatibilidade.
fn listOfInt(element: Gen[Int], maxLength: Int = 5) -> Gen[List[Int]] {
  return listOf(element, maxLength)
}

/// Lista de `String`; alias de `listOf` mantido para compatibilidade.
fn listOfString(element: Gen[String], maxLength: Int = 5) -> Gen[List[String]] {
  return listOf(element, maxLength)
}

/// String de `[a-z0-9]` com tamanho em `[0, maxLength]`; reduz removendo caracteres.
fn stringOf(maxLength: Int = 8) -> Gen[String] {
  val alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
  return Gen(
    fn(random: Rand) -> String {
      var result = ""
      val size = random.int(0, maxLength)
      var index = 0
      while (index < size) {
        val pick = random.int(0, len(alphabet) - 1)
        result = result + strings.slice(alphabet, pick, pick + 1)
        index = index + 1
      }
      return result
    },
    fn(value: String) -> List[String] {
      val candidates: List[String] = []
      var index = 0
      while (index < len(value)) {
        candidates.push(
          strings.slice(value, 0, index) +
          strings.slice(value, index + 1, len(value))
        )
        index = index + 1
      }
      return candidates
    }
  )
}

/// Escolhe um dos valores de `options` (não vazio); reduz para o primeiro.
fn oneOf[T](options: List[T]) -> Gen[T] {
  if (len(options) == 0) {
    raise RuntimeError("property.oneOf() expects a non-empty list.")
  }
  val first = options[0]
  return Gen(
    fn(random: Rand) -> T {
      return options[random.int(0, len(options) - 1)]
    },
    fn(value: T) -> List[T] {
      if (value == first) { return [] }
      return [first]
    }
  )
}

fn _fails[T](check: fn(T) -> Nil, value: T) -> Bool {
  try {
    check(value)
    return false
  } except Skip as _skip {
    raise _skip
  } except Exception as _error {
    return true
  }
}

fn _shrink[T](generator: Gen[T], value: T, check: fn(T) -> Nil) -> T {
  var current = value
  var rounds = 0
  while (rounds < 100) {
    var next: T? = nil
    var found = false
    for candidate in generator.smaller(current) {
      if (not found and _fails(check, candidate)) {
        next = candidate
        found = true
      }
    }
    if (next == nil) {
      return current
    }
    current = next
    rounds = rounds + 1
  }
  return current
}
