# std.rand — deterministic PRNG with an explicit seed (T3), pure Lox.
#
# `Rand` implements xorshift64*; the same seed always produces the same sequence in the
# tree-walk and the native backend. It is not cryptographically secure.

/// Deterministic xorshift64* generator; the same seed yields the same sequence.
class Rand {
  /// Internal state (never zero).
  var state: Int

  /// Creates a generator; `seed == 0` maps to the fixed default state.
  ///
  /// The seed is the only source of variation, so sequences are reproducible.
  fn init(seed: Int) {
    this.state = 88172645463325252 if seed == 0 else seed
  }

  /// Restarts the sequence with `seed`; `0` maps to the same default as `init`.
  fn reseed(seed: Int) -> Nil {
    this.state = 88172645463325252 if seed == 0 else seed
  }

  /// Returns the next raw 64-bit value.
  ///
  /// The `Int` may be negative; use `int` or `float` for bounded values.
  fn nextInt() -> Int {
    var x = this.state
    x = x ^ (x >>> 12)
    x = x ^ (x << 25)
    x = x ^ (x >>> 27)
    this.state = x
    return x * 2685821657736338717
  }

  /// Returns an integer in `[min, max]` (inclusive).
  ///
  /// Raises `RuntimeError` when `min > max` or when the span overflows an `Int`.
  fn int(min: Int, max: Int) -> Int {
    if (min > max) {
      raise RuntimeError("rand.int() expects min <= max.")
    }
    val span = max - min + 1
    if (span <= 0) {
      raise RuntimeError("rand.int() range is too large.")
    }
    val raw = this.nextInt() & 9223372036854775807
    return min + raw % span
  }

  /// Returns a `Float` in `[0.0, 1.0)` with 53 bits of mantissa.
  fn float() -> Float {
    val bits = this.nextInt() >>> 11
    return (bits as Float) / 9007199254740992.0
  }

  /// Returns `true` or `false` with equal probability.
  fn bool() -> Bool {
    return (this.nextInt() & 1) == 1
  }
}

/// Shuffles `items` in place with Fisher-Yates using `generator`.
///
/// Mutates the list and returns `nil`; the resulting order depends only on the
/// generator state.
fn shuffle[T](items: List[T], generator: Rand) -> Nil {
  var index = len(items) - 1
  while (index > 0) {
    val pick = generator.int(0, index)
    val value = items[index]
    items[index] = items[pick]
    items[pick] = value
    index = index - 1
  }
}
