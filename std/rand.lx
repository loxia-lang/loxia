# std.rand — PRNG determinístico com semente explícita (T3), em Lox puro.

/// Gerador xorshift64*; a mesma semente produz a mesma sequência.
class Rand {
  /// Estado interno (nunca zero).
  var state: Int

  /// Cria o gerador; `seed = 0` vira a constante padrão do xorshift.
  init(seed: Int) {
    this.state = 88172645463325252 if seed == 0 else seed
  }

  /// Reinicia a sequência com `seed`.
  fn reseed(seed: Int) -> Nil {
    this.state = 88172645463325252 if seed == 0 else seed
  }

  /// Próximo valor bruto de 64 bits (pode ser negativo).
  fn nextInt() -> Int {
    var x = this.state
    x = x ^ (x >>> 12)
    x = x ^ (x << 25)
    x = x ^ (x >>> 27)
    this.state = x
    return x * 2685821657736338717
  }

  /// Inteiro em `[min, max]` (inclusivo); erro se `min > max` ou range grande demais.
  fn int(min: Int, max: Int) -> Int {
    if (min > max) {
      raise RuntimeError("rand.int() expects min <= max.")
    }
    val span = max - min + 1
    if (span <= 0) {
      raise RuntimeError("rand.int() range is too large.")
    }
    val raw = this.nextInt() & 9223372036854775807
    return min + raw % span
  }

  /// Float em `[0.0, 1.0)` com 53 bits de mantissa.
  fn float() -> Float {
    val bits = this.nextInt() >>> 11
    return (bits as Float) / 9007199254740992.0
  }

  /// `true` ou `false` com probabilidade 1/2.
  fn bool() -> Bool {
    return (this.nextInt() & 1) == 1
  }
}

/// Embaralha `items` in-place (Fisher-Yates) usando `generator`.
fn shuffle[T](items: List[T], generator: Rand) -> Nil {
  var index = len(items) - 1
  while (index > 0) {
    val pick = generator.int(0, index)
    val value = items[index]
    items[index] = items[pick]
    items[pick] = value
    index = index - 1
  }
}
