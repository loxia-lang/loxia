# std.results — combinators for `Result[T, E]` (T1), pure Lox.
#
# `_ok`/`_err` exist so the checker can infer type arguments from the expected type;
# `map`, `mapErr` and `andThen` assign into a `var out: Result[...]`. A lambda that builds
# `Result.Ok`/`Result.Err` still cannot infer the generic enum, so use a named function
# with an annotated return type in that case.

fn _ok[U, E](value: U) -> Result[U, E] {
  return Result.Ok(value)
}

fn _err[U, E](error: E) -> Result[U, E] {
  return Result.Err(error)
}

/// Returns `true` for `Result.Ok` and `false` for `Result.Err`.
fn isOk[T, E](result: Result[T, E]) -> Bool {
  return match result {
    Result.Ok(_) => true
    Result.Err(_) => false
  }
}

/// Returns `true` for `Result.Err` and `false` for `Result.Ok`.
fn isErr[T, E](result: Result[T, E]) -> Bool {
  return match result {
    Result.Ok(_) => false
    Result.Err(_) => true
  }
}

/// Applies `transform` to the success value; an error passes through unchanged.
///
/// The error type `E` is preserved.
fn map[T, U, E](
  result: Result[T, E],
  transform: fn(T) -> U
) -> Result[U, E] {
  var out: Result[U, E]
  match result {
    Result.Ok(value) => out = _ok(transform(value))
    Result.Err(error) => out = _err(error)
  }
  return out
}

/// Applies `transform` to the error value; a success passes through unchanged.
///
/// The success type `T` is preserved.
fn mapErr[T, E, F](
  result: Result[T, E],
  transform: fn(E) -> F
) -> Result[T, F] {
  var out: Result[T, F]
  match result {
    Result.Ok(value) => out = _ok(value)
    Result.Err(error) => out = _err(transform(error))
  }
  return out
}

/// Returns the success value, or `fallback` for an error.
///
/// `fallback` is an ordinary argument, so it is evaluated before the call.
fn unwrapOr[T, E](result: Result[T, E], fallback: T) -> T {
  return match result {
    Result.Ok(value) => value
    Result.Err(_) => fallback
  }
}

/// Chains a computation that itself returns a `Result`.
///
/// On success `transform` is called; on error the original error is returned unchanged.
/// This is the monadic bind for `Result`.
fn andThen[T, U, E](
  result: Result[T, E],
  transform: fn(T) -> Result[U, E]
) -> Result[U, E] {
  var out: Result[U, E]
  match result {
    Result.Ok(value) => out = transform(value)
    Result.Err(error) => out = _err(error)
  }
  return out
}

/// Returns the success value, or `nil` when the result is an error.
///
/// The error value is discarded; use `match` when it must be inspected.
fn toOptional[T, E](result: Result[T, E]) -> T? {
  return match result {
    Result.Ok(value) => value
    Result.Err(_) => nil
  }
}
