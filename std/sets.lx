# std.sets — conjunto sobre `Map[Any, Bool]` (T2).
# A ordem de `toList` é a de inserção (determinística). `T` deve ser `String`, `Int`
# ou `Bool` no runtime: chaves de outro tipo são erro de runtime, porque constraints
# de chave genérica são pós-MVP (o campo é `Map[Any, Bool]`, a API pública é `Set[T]`).

/// A mutable set backed by `Map[Any, Bool]`.
class Set[T] {
  /// The backing map of elements.
  val items: Map[Any, Bool]

  /// Creates an empty set.
  init() {
    this.items = {}
  }

  /// Adds a value to the set.
  fn add(value: T) -> Nil {
    this.items[value] = true
  }

  /// Returns whether the set contains a value.
  fn has(value: T) -> Bool {
    return this.items.has(value)
  }

  /// Removes a value, returning whether it was present.
  fn remove(value: T) -> Bool {
    if (not this.items.has(value)) {
      return false
    }
    this.items.remove(value)
    return true
  }

  /// Returns the number of elements.
  fn len() -> Int {
    return len(this.items)
  }

  /// Returns the elements as a list in insertion order.
  fn toList() -> List[T] {
    val result: List[T] = []
    for key in this.items {
      result.push(key)
    }
    return result
  }

  /// Returns a new set with the elements of both sets.
  fn union(other: Set[T]) -> Set[T] {
    val result: Set[T] = Set()
    for value in this.toList() {
      result.add(value)
    }
    for value in other.toList() {
      result.add(value)
    }
    return result
  }

  /// Returns a new set with the common elements.
  fn intersect(other: Set[T]) -> Set[T] {
    val result: Set[T] = Set()
    for value in this.toList() {
      if (other.has(value)) {
        result.add(value)
      }
    }
    return result
  }

  /// Returns a new set with elements not in `other`.
  fn difference(other: Set[T]) -> Set[T] {
    val result: Set[T] = Set()
    for value in this.toList() {
      if (not other.has(value)) {
        result.add(value)
      }
    }
    return result
  }
}

/// Builds a set from a list, deduplicating values.
fn fromList[T](values: List[T]) -> Set[T] {
  val result: Set[T] = Set()
  for value in values {
    result.add(value)
  }
  return result
}
