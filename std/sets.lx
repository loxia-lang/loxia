# std.sets — mutable set backed by `Map[Any, Bool]` (T2), pure Lox.
#
# `toList` follows insertion order (deterministic). Runtime keys must be `String`, `Int`
# or `Bool`: other key types raise because generic key constraints are post-MVP (the
# field is `Map[Any, Bool]`, while the public API is `Set[T]`).

/// Mutable set backed by `Map[Any, Bool]`.
class Set[T] {
  /// Backing map; keys are elements and every value is `true`.
  val items: Map[Any, Bool]

  /// Creates an empty set.
  init() {
    this.items = {}
  }

  /// Adds `value`; adding an existing value is a no-op that keeps its position.
  fn add(value: T) -> Nil {
    this.items[value] = true
  }

  /// Returns whether `value` is in the set.
  fn has(value: T) -> Bool {
    return this.items.has(value)
  }

  /// Removes `value`, returning whether it was present.
  fn remove(value: T) -> Bool {
    if (not this.items.has(value)) {
      return false
    }
    this.items.remove(value)
    return true
  }

  /// Returns the number of elements.
  fn len() -> Int {
    return len(this.items)
  }

  /// Returns the elements as a list in insertion order.
  fn toList() -> List[T] {
    val result: List[T] = []
    for key in this.items {
      result.push(key)
    }
    return result
  }

  /// Returns a new set with the elements of both sets.
  ///
  /// Elements of `this` come first, followed by new elements of `other`.
  fn union(other: Set[T]) -> Set[T] {
    val result: Set[T] = Set()
    for value in this.toList() {
      result.add(value)
    }
    for value in other.toList() {
      result.add(value)
    }
    return result
  }

  /// Returns a new set with the elements present in both sets.
  ///
  /// Order follows `this`.
  fn intersect(other: Set[T]) -> Set[T] {
    val result: Set[T] = Set()
    for value in this.toList() {
      if (other.has(value)) {
        result.add(value)
      }
    }
    return result
  }

  /// Returns a new set with the elements of `this` that are not in `other`.
  ///
  /// Order follows `this`.
  fn difference(other: Set[T]) -> Set[T] {
    val result: Set[T] = Set()
    for value in this.toList() {
      if (not other.has(value)) {
        result.add(value)
      }
    }
    return result
  }
}

/// Builds a set from `values`, deduplicating in first-occurrence order.
fn fromList[T](values: List[T]) -> Set[T] {
  val result: Set[T] = Set()
  for value in values {
    result.add(value)
  }
  return result
}
