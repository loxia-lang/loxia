# SPDX-License-Identifier: MIT OR Apache-2.0
# std.test — mini test harness (T3, deterministic), pure Lox.
#
# `Suite.it` runs each body immediately and prints TAP, so there is no closure registry
# (R3) and no reflection (ADR-0096); the `lox test` runner only orchestrates `*_test.lx`
# files. State lives on the object because modules cannot declare top-level `var`:
# `val suite = t.Suite()`.
import std.strings as strings

/// Test failure (distinct from `RuntimeError`, which is an infrastructure bug).
class TestFailure(Exception) {
  /// Creates the failure with the message shown in the report.
  init(message: String) {
    this.message = message
  }
}

/// Test skipped on purpose; the runner counts it as `skip`, not as a failure.
class Skip(Exception) {
  /// Creates the skip with the given reason.
  init(reason: String) {
    this.message = reason
  }
}

/// Test suite: `describe`, `it`, `report` and `done`.
class Suite {
  /// Number of tests executed (filtered-out tests do not count).
  var total: Int
  /// Tests that passed.
  var passed: Int
  /// Tests that failed.
  var failed: Int
  /// Tests skipped with `skip`.
  var skipped: Int
  /// Group names opened by `describe`, innermost last.
  var prefixes: List[String]
  /// Substring filter read from `--filter=` in the script arguments.
  var filter: String
  /// Exact test name read from `--only=` in the script arguments.
  var only: String
  /// Hooks run before each `it`, in registration order.
  var beforeHooks: List[fn() -> Nil]
  /// Hooks run after each `it`, in reverse registration order.
  var afterHooks: List[fn() -> Nil]
  /// `--list`: print `# test <name>` only, without executing (per-test isolation).
  var listMode: Bool

  /// Creates an empty suite and reads `--filter=`/`--only=` from `args()`.
  ///
  /// Also detects `--list` and enables list mode.
  init() {
    this.total = 0
    this.passed = 0
    this.failed = 0
    this.skipped = 0
    this.prefixes = []
    this.filter = ""
    this.only = ""
    this.beforeHooks = []
    this.afterHooks = []
    this.listMode = false
    for argument in args() {
      if (argument == "--list") {
        this.listMode = true
      }
    }
    for argument in args() {
      if (strings.startsWith(argument, "--filter=")) {
        this.filter = strings.slice(argument, 9, len(argument))
      } else if (strings.startsWith(argument, "--only=")) {
        this.only = strings.slice(argument, 7, len(argument))
      }
    }
  }

  /// Opens a group; its name prefixes every `it` and its hooks apply only here.
  ///
  /// Hooks registered inside the body are removed when the body returns.
  fn describe(name: String, body: fn() -> Nil) -> Nil {
    this.prefixes.push(name)
    val beforeMark = len(this.beforeHooks)
    val afterMark = len(this.afterHooks)
    try {
      body()
    } finally {
      this.prefixes.pop()
      _truncate(this.beforeHooks, beforeMark)
      _truncate(this.afterHooks, afterMark)
    }
  }

  /// Registers a hook run before each `it` in this `describe`.
  fn beforeEach(body: fn() -> Nil) -> Nil {
    this.beforeHooks.push(body)
  }

  /// Registers a hook run after each `it` in this `describe`.
  fn afterEach(body: fn() -> Nil) -> Nil {
    this.afterHooks.push(body)
  }

  /// Runs a test immediately and prints `ok`/`not ok` in TAP.
  ///
  /// Filtered tests do not run or count. A skipped test still counts in `total` but not
  /// as passed or failed. A failure in `beforeEach`/`afterEach` is reported as a test
  /// failure.
  fn it(name: String, body: fn() -> Nil) -> Nil {
    val full = this._fullName(name)
    if (not this._selected(full)) {
      return
    }
    if (this.listMode) {
      print("# test ${full}")
      return
    }
    this.total = this.total + 1
    var message = ""
    var skipped = false
    var skipReason = ""
    var beforeFailed = false
    try {
      this._runBefore()
    } except Skip as e {
      skipped = true
      skipReason = e.message
    } except Exception as e {
      message = "beforeEach: " + e.message
      beforeFailed = true
    }
    if (not beforeFailed and not skipped) {
      try {
        body()
      } except Skip as e {
        skipped = true
        skipReason = e.message
      } except Exception as e {
        message = e.message
      }
    }
    try {
      this._runAfter()
    } except Skip as e {
      if (not skipped) {
        skipped = true
        skipReason = e.message
      }
    } except Exception as e {
      if (message == "") {
        message = "afterEach: " + e.message
      } else {
        message = message + "\nafterEach: " + e.message
      }
    }
    if (skipped) {
      this.skipped = this.skipped + 1
      print("ok ${this.total} - ${full} # SKIP ${skipReason}")
    } else if (message == "") {
      this.passed = this.passed + 1
      print("ok ${this.total} - ${full}")
    } else {
      this.failed = this.failed + 1
      this._reportFailure(this.total, full, message)
    }
  }

  /// Skips the current test with `reason`.
  ///
  /// Raises `Skip`, which `it` turns into a `# SKIP` line rather than a failure.
  fn skip(reason: String) -> Nil {
    raise Skip(reason)
  }

  /// Prints the TAP plan and summary, returning 0 (all passed) or 1 (any failure).
  fn report() -> Int {
    print("1..${this.total}")
    print("# tests ${this.total}")
    print("# pass ${this.passed}")
    print("# fail ${this.failed}")
    print("# skip ${this.skipped}")
    if (this.failed > 0) {
      return 1
    }
    return 0
  }

  /// Calls `report()` and exits the process with its code.
  ///
  /// In `--list` mode it exits 0 immediately.
  fn done() -> Nil {
    if (this.listMode) {
      os.exit(0)
    }
    os.exit(this.report())
  }

  fn _runBefore() -> Nil {
    for hook in this.beforeHooks {
      hook()
    }
  }

  fn _runAfter() -> Nil {
    var index = len(this.afterHooks) - 1
    while (index >= 0) {
      this.afterHooks[index]()
      index = index - 1
    }
  }

  fn _fullName(name: String) -> String {
    if (len(this.prefixes) == 0) {
      return name
    }
    return join(this.prefixes, " / ") + " / " + name
  }

  fn _selected(full: String) -> Bool {
    if (this.only != "" and full != this.only) {
      return false
    }
    if (this.filter != "" and not strings.contains(full, this.filter)) {
      return false
    }
    return true
  }

  fn _reportFailure(number: Int, name: String, message: String) -> Nil {
    print("not ok ${number} - ${name}")
    for line in strings.splitLines(message) {
      print("  # ${line}")
    }
  }
}

fn _truncate[T](items: List[T], size: Int) -> Nil {
  while (len(items) > size) {
    items.pop()
  }
}

/// Equality assertion for a concrete value (scalar, string, list, map or tuple).
class Expectation[T] {
  /// Observed value.
  val value: T

  /// Wraps the observed value.
  init(value: T) {
    this.value = value
  }

  /// Fails when `value != other`.
  fn toBe(other: T) -> Nil {
    if (this.value != other) {
      raise TestFailure("expected ${repr(other)}, got ${repr(this.value)}")
    }
  }

  /// Fails when `value == other`.
  fn notToBe(other: T) -> Nil {
    if (this.value == other) {
      raise TestFailure("expected not ${repr(other)}")
    }
  }
}

/// Assertion over the elements of a list.
class ListExpectation[T] {
  /// Observed list.
  val items: List[T]

  /// Wraps the observed list.
  init(items: List[T]) {
    this.items = items
  }

  /// Fails when `item` is not in the list (structural equality).
  fn toContain(item: T) -> Nil {
    for current in this.items {
      if (current == item) {
        return
      }
    }
    raise TestFailure(
      "expected ${repr(this.items)} to contain ${repr(item)}"
    )
  }
}

/// Assertion over the contents of a string.
class StringExpectation {
  /// Observed text.
  val text: String

  /// Wraps the observed text.
  init(text: String) {
    this.text = text
  }

  /// Fails when `text` does not contain `needle`.
  fn contains(needle: String) -> Nil {
    if (not strings.contains(this.text, needle)) {
      raise TestFailure(
        "expected ${repr(this.text)} to contain ${repr(needle)}"
      )
    }
  }
}

/// Records calls of a spy/fake: `record`, `count`, `order` and `clear`.
class Recorder {
  /// Calls in registration order.
  val calls: List[String]

  /// Creates an empty recorder.
  init() {
    this.calls = []
  }

  /// Records one call by name.
  fn record(name: String) -> Nil {
    this.calls.push(name)
  }

  /// Returns how many times `name` was recorded.
  fn count(name: String) -> Int {
    var total = 0
    for call in this.calls {
      if (call == name) {
        total = total + 1
      }
    }
    return total
  }

  /// Returns a copy of the calls in registration order.
  fn order() -> List[String] {
    val copy: List[String] = []
    for call in this.calls {
      copy.push(call)
    }
    return copy
  }

  /// Empties the record.
  fn clear() -> Nil {
    while (len(this.calls) > 0) {
      this.calls.pop()
    }
  }
}

/// Fails the current test with `message`.
fn fail(message: String) -> Nil {
  raise TestFailure(message)
}

/// Wraps a concrete value for `toBe`/`notToBe`.
fn expect[T](value: T) -> Expectation[T] {
  return Expectation(value)
}

/// Fails when `actual <= expected` (natural order of `T: Ord`).
fn expectGt[T: Ord](actual: T, expected: T) -> Nil {
  if (actual <= expected) {
    raise TestFailure("expected > ${repr(expected)}, got ${repr(actual)}")
  }
}

/// Fails when `actual < expected`.
fn expectGe[T: Ord](actual: T, expected: T) -> Nil {
  if (actual < expected) {
    raise TestFailure("expected >= ${repr(expected)}, got ${repr(actual)}")
  }
}

/// Fails when `actual >= expected`.
fn expectLt[T: Ord](actual: T, expected: T) -> Nil {
  if (actual >= expected) {
    raise TestFailure("expected < ${repr(expected)}, got ${repr(actual)}")
  }
}

/// Fails when `actual > expected`.
fn expectLe[T: Ord](actual: T, expected: T) -> Nil {
  if (actual > expected) {
    raise TestFailure("expected <= ${repr(expected)}, got ${repr(actual)}")
  }
}

/// Fails when `value` is not `nil`.
///
/// Pass a typed optional (`val x: Int? = nil`): `expectNil(nil)` is a nested optional and
/// the backend rejects it.
fn expectNil[T](value: T?) -> Nil {
  if (value != nil) {
    raise TestFailure("expected nil, got ${repr(value)}")
  }
}

/// Fails when `value` is `nil`; returns the narrowed value.
fn expectNotNil[T](value: T?) -> T {
  if (value == nil) {
    raise TestFailure("expected a non-nil value")
  }
  return value
}

/// Wraps a list for `toContain`.
fn expectList[T](items: List[T]) -> ListExpectation[T] {
  return ListExpectation(items)
}

/// Wraps a string for `contains`.
fn expectString(text: String) -> StringExpectation {
  return StringExpectation(text)
}

/// Runs `body` and returns the exception message; fails when nothing is raised.
///
/// Catches any `Exception`, including `Skip` and `TestFailure`.
fn expectRaise(body: fn() -> Nil) -> String {
  try {
    body()
  } except Exception as e {
    return e.message
  }
  raise TestFailure("expected an exception, none was raised")
}
