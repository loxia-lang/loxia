# std.utf8 — UTF-8/UTF-16 widths (T2), pure Lox over `charCodeAt`; deterministic.
#
# LSP and any positional protocol need both units for the same text: `byteLen` for
# `Content-Length` and `utf16Column` for an editor column. Lengths count code points;
# surrogate pairs count as two UTF-16 units.

/// Counts the UTF-8 bytes of `text` (1..4 per code point).
fn byteLen(text: String) -> Int {
  var total = 0
  var index = 0
  while (index < len(text)) {
    val code = charCodeAt(text, index)
    if (code < 0x80) {
      total = total + 1
    } else if (code < 0x800) {
      total = total + 2
    } else if (code < 0x10000) {
      total = total + 3
    } else {
      total = total + 4
    }
    index = index + 1
  }
  return total
}

/// Counts the UTF-16 code units of `text` (2 for code points above U+FFFF).
fn utf16Len(text: String) -> Int {
  var total = 0
  var index = 0
  while (index < len(text)) {
    total = total + (2 if charCodeAt(text, index) > 0xFFFF else 1)
    index = index + 1
  }
  return total
}

/// Returns the UTF-16 width of the prefix of `index` code points.
///
/// `index` is clamped to 0..len(text), so negative and out-of-range values do not raise.
fn utf16Column(text: String, index: Int) -> Int {
  var end = index
  if (end < 0) {
    end = 0
  }
  if (end > len(text)) {
    end = len(text)
  }
  var total = 0
  var current = 0
  while (current < end) {
    total = total + (2 if charCodeAt(text, current) > 0xFFFF else 1)
    current = current + 1
  }
  return total
}
