# Bytes: construção, len/índice, métodos e formatação (interpretador; backend no 79b).
val text = Bytes.fromText("é")
print(len(text))
print(text[0])
print(text[1])
print(text)
print(repr(text))
print("${text}")
val data = Bytes.fromList([0, 255, 16])
print(data.toHex())
print(data.toList())
print(data.slice(1, 3).toHex())
print(data.concat(Bytes.fromText("A")).toHex())
print(data == Bytes.fromList([0, 255, 16]))
print(data == Bytes.fromList([0, 255]))
print(data == text)
print(len("é"))
print(len(data))
print(data.toBase64())
print(Bytes.empty().toHex())
print(match text.toText() { Result.Ok(value) => value, Result.Err(error) => error.kind })
print(match data.toText() { Result.Ok(value) => value, Result.Err(error) => error.kind })
print(match Bytes.fromHex("FF") { Result.Ok(value) => value.toHex(), Result.Err(error) => error.kind })
print(match Bytes.fromHex("F") { Result.Ok(_) => "ok", Result.Err(error) => error.kind })
print(match Bytes.fromBase64("Zm9v") { Result.Ok(value) => value.toText(), Result.Err(error) => error.kind })
print(match Bytes.fromBase64("Zg") { Result.Ok(_) => "ok", Result.Err(error) => error.kind })
print(match Bytes.fromBase64("Zh==") { Result.Ok(_) => "ok", Result.Err(error) => error.kind })
val hex = data.toHex
print(hex())
val maybe: Bytes? = data
print(maybe?.toHex())
val nothing: Bytes? = nil
print(nothing?.toHex())
val any: Any = data
print(any is Bytes)
print((any as Bytes).toHex())
val error = BytesError("invalidHex", "detail")
print(error.kind)
print(error.message)
print(error is BytesError)
