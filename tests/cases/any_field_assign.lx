# Campo `Any`/união: o slot guarda o box `{tag, payload}` (ADR-0145).
class C {
  var x: Any = 1
  var y: Int | String = 1
}

val c = C()
print(c.x) # expect: 1
c.x = "s"
print(c.x) # expect: s
c.x = 2.5
print(c.x) # expect: 2.5
c.x = true
print(c.x) # expect: true
c.x = nil
print(c.x)         # expect: nil
print(c.x is Nil)  # expect: true
c.x = [1, "a"]
print(c.x) # expect: [1, "a"]
c.x = 7
print(c.x ?? 0) # expect: 7
c.y = "t"
print(c.y)       # expect: t
print(c.x == 7)  # expect: true
