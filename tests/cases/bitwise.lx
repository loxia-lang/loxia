print(5 & 3)      # expect: 1
print(5 | 3)      # expect: 7
print(5 ^ 3)      # expect: 6
print(~0)         # expect: -1
print(~5)         # expect: -6
print(1 << 3)     # expect: 8
print(-8 >> 1)    # expect: -4
print(-1 >>> 1)   # expect: 9223372036854775807
print(-1 >>> 63)  # expect: 1
print(-1 << 1)    # expect: -2
print(1 << 63)    # expect: -9223372036854775808
