var total = 0
for i in 0..10 {
  if (i == 3) { continue }
  if (i == 6) { break }
  total = total + i
}
print(total)

var n = 0
while (true) {
  n = n + 1
  if (n < 3) { continue }
  if (n == 5) { break }
}
print(n)

var log = ""
while (true) {
  try {
    break
  } finally {
    log = log + "f"
  }
}
print(log)

for i in 0..2 {
  for j in 0..2 {
    if (j == 1) { break }
    print("${i}:${j}")
  }
}

var logged = ""
for i in 0..3 {
  try {
    if (i == 1) { continue }
    if (i == 2) { break }
  } finally {
    logged = logged + "f"
  }
  print(i)
}
print(logged)

# expect: 12
# expect: 5
# expect: f
# expect: 0:0
# expect: 1:0
# expect: 0
# expect: fff
