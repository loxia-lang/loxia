class Holder {
  val data: Bytes

  fn init(data: Bytes) {
    this.data = data
  }
}

fn identity(value: Bytes) -> Bytes {
  return value
}

val b = Bytes.fromText("é")
val holder = Holder(b)
print(holder.data.toHex())
print(identity(b).toHex())
val map: Map[String, Bytes] = { "a": b }
print(map["a"].toHex())
val tuple = (b, 1)
print(tuple[0])

# expect: c3a9
# expect: c3a9
# expect: c3a9
# expect: 0xc3a9
