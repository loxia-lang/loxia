print(3.9 as Int);              # expect: 3
print(3 as Float);              # expect: 3.0
print(Int.parse("42"));         # expect: 42
print(Int.parse("x"));          # expect: nil
print(Float.parse("3.5"));      # expect: 3.5

print(math.abs(-3));            # expect: 3
print(math.abs(-3.5));          # expect: 3.5
print(math.floor(3.9));         # expect: 3
print(math.ceil(3.1));          # expect: 4
print(math.round(2.5));         # expect: 3
print(math.round(-2.5));        # expect: -3
print(math.trunc(-3.9));        # expect: -3
print(math.sqrt(9.0));          # expect: 3.0
print(math.min(2, 3));          # expect: 2
print(math.max(2.0, 3));        # expect: 3.0
print(math.clamp(10, 0, 5));    # expect: 5
