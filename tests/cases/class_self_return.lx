# Método retornando a própria classe (iter() -> Self).
class Counter {
  var value: Int

  fn init() {
    this.value = 0
  }

  fn me() -> Counter {
    return this
  }

  fn bump() -> Counter {
    this.value = this.value + 1
    return this
  }
}

val counter = Counter()
print(counter.me() == counter)
print(counter.bump().bump().value)
# expect: true
# expect: 2
