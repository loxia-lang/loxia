# Enums com payload, igualdade e match exaustivo.
enum Cor { Vermelho, Verde, Azul }
enum Shape { Circle(Float), Rect(Float, Float) }

print Cor.Verde
print Cor.Verde == Cor.Verde
print Cor.Verde == Cor.Azul

val s: Shape = Shape.Circle(2.0)
val area = match s {
  Shape.Circle(r) => 3.14 * r * r
  Shape.Rect(w, h) => w * h
}
print area
print match Shape.Rect(2.0, 3.0) {
  Shape.Circle(r) => r
  Shape.Rect(w, h) => w * h
}
# expect: Cor.Verde
# expect: true
# expect: false
# expect: 12.56
# expect: 6.0
