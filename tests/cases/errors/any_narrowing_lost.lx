# O diagnóstico nomeia a chamada que derrubou o refino (ADR-0141).
class P {
  var nome: String? = nil

  init(nome: String?) {
    this.nome = nome
  }
}

fn limpar(p: P) -> Nil {
  p.nome = nil
}

val p = P("a")
if (p.nome != nil) {
  limpar(p)
  print(len(p.nome))
}
