class E(Exception) {
  fn init(m: String) {
    this.message = m
  }
}

try {
  raise E("x")
} except E as e {
  print(e.site)
}
try {
  val z = 0
  print(1 // z)
} except RuntimeError as e {
  print(e.site)
}
