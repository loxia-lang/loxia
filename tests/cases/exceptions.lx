# try/except/finally com exceções tipadas e erros de runtime.
class MyError(Exception) {
  init(msg: String) { this.message = msg }
}

try {
  raise MyError("falhou")
} except MyError as e {
  print "meu: ${e.message}"
} finally {
  print "fim"
}

try {
  print 1 / 0
} except RuntimeError as e {
  print "runtime"
}

try { raise MyError("x") }
except RuntimeError as e { print "errado" }
except Exception as e { print "generico" }

fn f() -> Int {
  try { return 1 } finally { return 2 }
}
print f()
# expect: meu: falhou
# expect: fim
# expect: runtime
# expect: generico
# expect: 2
