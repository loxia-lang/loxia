print 2 ** 3          # expect: 8
print 2 ** 3 ** 2     # expect: 512
print -2 ** 2         # expect: -4
print (-2) ** 2       # expect: 4
print 2 ** -1.0       # expect: 0.5
print 2.0 ** -1       # expect: 0.5
print 2 ** 0.5        # expect: 1.4142135623730951
print 2.0 ** 3        # expect: 8.0
print 0 ** 0          # expect: 1
print 2 ** 63         # expect: -9223372036854775808
