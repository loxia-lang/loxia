# Campos declarados são herdados; `var` continua mutável na subclasse.
class A {
  var x: Int;

  init(x: Int) {
    this.x = x;
  }
}

class B(A) {
  var y: Int;

  init(x: Int, y: Int) {
    super.init(x);
    this.y = y;
  }
}

var b = B(1, 2);
print b.x + b.y;  # expect: 3

b.x = 10;
print b.x;  # expect: 10
