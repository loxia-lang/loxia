fn id[T](x: T) -> T {
  return x
}

fn map[T, U](xs: List[T], f: fn(T) -> U) -> List[U] {
  val out: List[U] = []
  for x in xs {
    out.push(f(x))
  }
  return out
}

print(id(1))                        # expect: 1
print(id("a"))                      # expect: a
print(map([1, 2], fn(x) => x * 2))  # expect: [2, 4]
