# Subclasse com `init` chama `super.init(...)` explicitamente.
class Animal {
  var nome: String;
  init(nome: String) {
    this.nome = nome;
  }
}

class Cachorro(Animal) {
  var raca: String;
  init(nome: String, raca: String) {
    super.init(nome);
    this.raca = raca;
  }
}

var rex = Cachorro("Rex", "vira-lata");
print(rex.nome);  # expect: Rex
print(rex.raca);  # expect: vira-lata
