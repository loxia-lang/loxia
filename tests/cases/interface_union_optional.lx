# `??` em união de interface/lista com Nil usa o tipo comum (ADR-0146/#221).
interface I {
  fn m() -> Int
}

class C implements I {
  fn m() -> Int {
    return 1
  }
}

val maybe: I | Nil = nil
val x: I = maybe ?? C()
print(x.m()) # expect: 1

val y: I | Nil = C()
print((y ?? C()).m()) # expect: 1

val xs: List[Int] | Nil = nil
print(xs ?? [1, 2]) # expect: [1, 2]

class Base {
  fn n() -> Int {
    return 1
  }
}

class Sub(Base) {
  fn n() -> Int {
    return 2
  }
}

val sub: Sub? = nil
val base: Base = sub ?? Base()
print(base.n()) # expect: 1

val some: I = C()
val none: C? = nil
print((none ?? some).m()) # expect: 1

val a: String? = nil
val b: String? = nil
val c: String? = a ?? b
print(c ?? "x") # expect: x

val i: Int? = nil
print(i ?? i) # expect: nil

val elems: List[I?] = [nil, C()]
print((elems[1] ?? C()).m())  # expect: 1
print((elems[0] ?? C()).m())  # expect: 1
