# Igualdade estrutural de listas.
print [1, 2] == [1, 2]
print [1, 2] == [2, 1]
print [1, [2, 3]] == [1, [2, 3]]
print [1, 2] != [1, 2]
print [1, 2] == [1, 2.0]
print 1 == [1]
print nil == []
# expect: true
# expect: false
# expect: true
# expect: false
# expect: true
# expect: false
# expect: false
