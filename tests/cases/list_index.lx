# Acesso e atribuição por índice, inclusive aninhados.
val xs: List[Int] = [10, 20, 30]
print(xs[0])
print(xs[2])
xs[1] = 25
print(xs)
print(xs[0] + xs[1])

val nested: List[List[Int]] = [[1], [2, 3]]
nested[0][0] = 9
print(nested)
# expect: 10
# expect: 30
# expect: [10, 25, 30]
# expect: 35
# expect: [[9], [2, 3]]
