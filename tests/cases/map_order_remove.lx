# Ordem de inserção após remove e reinserção (o dict do Python é o oráculo).
val m = { "a": 1, "b": 2, "c": 3 }
m.remove("b")
m["b"] = 9
for k in m {
  print(k)
}
print(m.keys())
print(m.values())
print(len(m))
m.remove("a")
m["a"] = 0
print(m)
print(m.has("a"))
print(m.get("b"))
# expect: a
# expect: c
# expect: b
# expect: ["a", "c", "b"]
# expect: [1, 3, 9]
# expect: 3
# expect: {"c": 3, "b": 9, "a": 0}
# expect: true
# expect: 9
