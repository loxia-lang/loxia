# Destructuring aninhado: val/var, anotação e captura por closure (ADR-0069).
val (a, (b, c)) = (1, (2, 3))
print(a)
print(b)
print(c)

var (x, (y, z)): (Int, (String, Bool)) = (4, ("oi", true))
print(x)
print(y)
print(z)

fn soma() -> Int {
  val (p, (q, (r, s))) = (10, (20, (30, 40)))
  val total = fn() => p + q + r + s
  return total()
}

print(soma())
# expect: 1
# expect: 2
# expect: 3
# expect: 4
# expect: oi
# expect: true
# expect: 100
