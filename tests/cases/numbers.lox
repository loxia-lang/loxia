// Int e Float são tipos distintos (TIPOS.md D-1..D-6).

print 0;            // expect: 0
print 42;           // expect: 42
print 1_000_000;    // expect: 1000000
print 0xFF;         // expect: 255
print 0b1010;       // expect: 10
print 0o755;        // expect: 493

print 3.14;         // expect: 3.14
print 1e9;          // expect: 1000000000.0
print 1.5e-3;       // expect: 0.0015
print 1.0;          // expect: 1.0
print -0.0;         // expect: -0.0

print 1 + 2;        // expect: 3
print 1 + 2.0;      // expect: 3.0
print 4 / 2;        // expect: 2.0
print 1 / 2;        // expect: 0.5
print 10 % 3;       // expect: 1
print -7 % 3;       // expect: -1
print 7.5 % 2;      // expect: 1.5

print 1 == 1.0;     // expect: true
print 1 < 1.5;      // expect: true
print 2 >= 2.0;     // expect: true

print 9223372036854775807 + 1;   // expect: -9223372036854775808
print -9223372036854775807 - 2;  // expect: 9223372036854775807
