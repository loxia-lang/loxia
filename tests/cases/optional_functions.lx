# L2.5: T? em parâmetros, retornos e closures.
fn id(x: Int?) -> Int? {
  return x
}

print(id(nil))  # expect: nil
print(id(5))    # expect: 5

fn soma(x: Int?) -> Int {
  if (x != nil) return x + 1
  return 0
}

print(soma(nil))  # expect: 0
print(soma(4))    # expect: 5

fn make() -> fn() -> Int? {
  var x: Int?
  return fn() -> Int? {
    x = 3
    return x
  }
}

val f = make()
print(f()) # expect: 3
