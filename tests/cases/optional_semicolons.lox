fn soma(a, b) {
  return a + b
}

val a = 1
var b = 2
b = b + 1

print a          // expect: 1
print b          // expect: 3
print soma(a, b) // expect: 4

if (a < b) print "menor"
else print "maior"  // expect: menor

class P {
  var x
  var y

  init() {
    this.x = 1
    this.y = 2
  }

  soma() {
    return this.x + this.y
  }
}

print P().soma() // expect: 3

for i in 0..2 {
  print i // expect: 0
}         // expect: 1
