# Result embutido: generic enum + match.
fn parse(n: Int) -> Result[Int, String] {
  if (n > 0) {
    return Result.Ok(n)
  }
  return Result.Err("negativo")
}

val r = parse(3)
print(r)
print(
  match r {
    Result.Ok(v) => v
    Result.Err(e) => e
  },
)
print(
  match parse(0) {
    Result.Ok(v) => "ok ${v}"
    Result.Err(e) => "erro ${e}"
  },
)
# expect: Result.Ok(3)
# expect: 3
# expect: erro negativo
