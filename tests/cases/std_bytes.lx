# std.bytes: Builder incremental, compare lexicográfico e helpers de endian.
import std.bytes as bytes

val builder = bytes.Builder()
builder.push(Bytes.fromText("é")).pushByte(65).push(Bytes.fromList([0, 255]))
val data = builder.build()
print(builder.len())
print(data.toHex())
print(data.toBase64())
print(bytes.compare(Bytes.fromList([1, 2]), Bytes.fromList([1, 3])))
print(bytes.compare(Bytes.fromList([1, 2]), Bytes.fromList([1, 2])))
print(bytes.compare(Bytes.fromList([1, 2]), Bytes.fromList([1])))
print(bytes.u16be(4660).toHex())
print(bytes.u16le(4660).toHex())
print(bytes.u32be(305419896).toHex())
print(bytes.u32le(305419896).toHex())
print(bytes.u64be(-1).toHex())
print(bytes.u64le(-1).toHex())
var invalid = "no"
try {
  bytes.Builder().pushByte(256)
} except RuntimeError as error {
  invalid = error.message
}
print(invalid)

val chunks = bytes.ChunkBuilder()
chunks.push(Bytes.fromText("ab")).push(Bytes.fromText("cd")).push(Bytes.empty())
print(chunks.len())
print(chunks.build().toHex())
print(chunks.build().toHex())
print(bytes.ChunkBuilder().build().toHex())
val odd = bytes.ChunkBuilder()
odd.push(Bytes.fromText("ab")).push(Bytes.fromText("cd")).push(Bytes.fromText("ef"))
print(odd.build().toHex())

# expect: 5
# expect: c3a94100ff
# expect: w6lBAP8=
# expect: -1
# expect: 0
# expect: 1
# expect: 1234
# expect: 3412
# expect: 12345678
# expect: 78563412
# expect: ffffffffffffffff
# expect: ffffffffffffffff
# expect: Builder.pushByte() expects 0..255.
