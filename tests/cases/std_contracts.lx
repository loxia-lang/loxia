# std.contracts: require/ensure/invariant and the check* helpers.
from std.contracts import ContractError, check, checkInvariant, checkMethod, checkMethodVoid, checkVoid, ensure, require

fn div(a: Int, b: Int) -> Int {
  return check(
    "div",
    fn() => a >= 0 and b > 0,
    fn() => a // b,
    fn(result: Int) => result * b <= a
  )
}
print(div(7, 2))  # expect: 3

try {
  div(7, 0)
} except ContractError as e {
  print("pre: " + e.message)  # expect: pre: div: precondition failed
}

fn badPost(n: Int) -> Int {
  return check("badPost", fn() => true, fn() => n, fn(result: Int) => result > 0)
}
try {
  badPost(0)
} except ContractError as e {
  print("post: " + e.message)  # expect: post: badPost: postcondition failed
}

fn logTwice(message: String) -> Nil {
  checkVoid(
    "logTwice",
    fn() => len(message) > 0,
    fn() -> Nil {
      print(message)
      print(message)
    },
    fn() => true
  )
}
logTwice("x")  # expect: x
# expect: x

fn noop(x: Int) -> Nil {
  return check(
    "noop",
    fn() => x > 0,
    fn() -> Nil {
      print("noop ${x}")
    },
    fn(_result: Nil) => true
  )
}
noop(4)  # expect: noop 4

class Counter {
  var n: Int

  init(n: Int) {
    require(n >= 0, "Counter: n >= 0")
    this.n = n
  }

  fn bump() -> Nil {
    checkMethodVoid(
      "Counter.bump",
      this,
      fn(c: Counter) => c.n >= 0,
      fn(c: Counter) -> Nil {
        c.n = c.n + 1
      },
      fn(c: Counter) => c.n > 0
    )
  }

  fn read() -> Int {
    return checkMethod(
      "Counter.read",
      this,
      fn(c: Counter) => c.n >= 0,
      fn(c: Counter) => c.n,
      fn(c: Counter, result: Int) => result == c.n
    )
  }
}

val counter = Counter(1)
counter.bump()
print(counter.read())  # expect: 2

fn keepNonNegative(xs: List[Int]) -> List[Int] {
  return check(
    "keepNonNegative",
    fn() => true,
    fn() -> List[Int] {
      val out: List[Int] = []
      for x in xs {
        if (x >= 0) {
          out.push(x)
        }
      }
      return out
    },
    fn(result: List[Int]) => len(result) <= len(xs)
  )
}
print(keepNonNegative([1, -2, 3]))  # expect: [1, 3]

checkInvariant(1 < 2, "one")
try {
  checkInvariant(false, "boom")
} except ContractError as e {
  print("inv: " + e.message)  # expect: inv: boom
}

fn absSafe(value: Int) -> Int {
  ensure(value != -9223372036854775807 - 1, "absSafe: INT_MIN")
  if (value < 0) {
    return -value
  }
  return value
}
print(absSafe(-7))  # expect: 7

# ContractError is not RuntimeError: the inner handler must not catch it.
try {
  try {
    require(false, "boom")
  } except RuntimeError as e {
    print("wrong: " + e.message)
  }
} except ContractError as e {
  print("not runtime: " + e.message)  # expect: not runtime: boom
}

fn preSkipsBody() -> Bool {
  var executed = false
  try {
    check(
      "skip",
      fn() => false,
      fn() -> Int {
        executed = true
        return 1
      },
      fn(result: Int) => result == 1
    )
  } except ContractError as e {
    print("skip: " + e.message)  # expect: skip: skip: precondition failed
  }
  return executed
}
print(preSkipsBody())  # expect: false

fn catchCapture() -> String {
  try {
    raise RuntimeError("x")
  } except RuntimeError as e {
    val label = fn() => e.message
    return label()
  }
  return ""
}
print(catchCapture())  # expect: x
