# std.hash: FNV-1a 32/64 e djb2 sobre bytes UTF-8.
from std.hash import fnv1a32, fnv1a64, djb2

print(fnv1a32(""))
print(fnv1a32("a"))
print(fnv1a32("foobar"))
print(fnv1a32("ação"))
print(fnv1a32("😀"))
print(fnv1a64(""))
print(fnv1a64("a"))
print(fnv1a64("foobar"))
print(fnv1a64("ação"))
print(fnv1a64("😀"))
print(djb2(""))
print(djb2("a"))
print(djb2("foobar"))
print(djb2("ação"))
print(djb2("😀"))
