# std.hash.sha256Bytes: raw 32-byte SHA-256, same vectors as the text wrapper.
import std.hash as hash

print(hash.sha256Bytes(Bytes.fromText("abc")).toHex())
print(hash.sha256Bytes(Bytes.empty()).toHex())
print(hash.sha256Bytes(Bytes.fromList([0, 255])).toHex())
print(hash.sha256("abc"))

