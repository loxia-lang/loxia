# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
# expect: err:-32600:Invalid Request
