# std.jsonrpc (L6): typed `RpcFailure.data` and the `error` accessor.
import std.jsonrpc as rpc
from std.jsonrpc import RpcFailure

fn show(result: Result[Map[String, Any], RpcFailure]) -> String {
  return match result {
    Result.Ok(message) => "ok:" + rpc.encode(message)
    Result.Err(error) => "err:${error.code}:${error.message}:${error.data}"
  }
}

fn describe(error: RpcFailure?) -> String {
  if (error == nil) {
    return "none"
  }
  val failure = error as RpcFailure
  if (failure.data is Map[String, Any]) {
    val entry = failure.data as Map[String, Any]
    return "map:${entry["kind"]}"
  }
  if (failure.data is List[Any]) {
    val list = failure.data as List[Any]
    return "list:${len(list)}"
  }
  if (failure.data is Int) {
    val number = failure.data as Int
    return "int:${number}"
  }
  if (failure.data is String) {
    val text = failure.data as String
    return "string:${text}"
  }
  if (failure.data is Bool) {
    val flag = failure.data as Bool
    return "bool:${flag}"
  }
  return "nil"
}

fn describeBody(body: String) -> String {
  return match rpc.decode(body) {
    Result.Ok(message) => describe(rpc.errorOf(message))
    Result.Err(error) => "decode:${error.code}:${error.data}"
  }
}

fn errorOfRaw(message: Map[String, Any]) -> String {
  val failure = rpc.errorOf(message)
  if (failure == nil) {
    return "nil"
  }
  val typed = failure as RpcFailure
  return "code:${typed.code}"
}

print(
  describeBody(
    "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32602,\"message\":\"bad\",\"data\":{\"kind\":\"params\"}}}",
  ),
)
print(
  describeBody(
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32603,\"message\":\"boom\",\"data\":[1,2,3]}}",
  ),
)
print(
  describeBody(
    "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":1,\"message\":\"int\",\"data\":7}}",
  ),
)
print(
  describeBody(
    "{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":2,\"message\":\"str\",\"data\":\"why\"}}",
  ),
)
print(
  describeBody(
    "{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":3,\"message\":\"bool\",\"data\":true}}",
  ),
)
print(describeBody("{\"jsonrpc\":\"2.0\",\"id\":6,\"error\":{\"code\":4,\"message\":\"none\"}}"))
print(
  describeBody(
    "{\"jsonrpc\":\"2.0\",\"id\":11,\"error\":{\"code\":5,\"message\":\"null\",\"data\":null}}",
  ),
)
print(describeBody("{\"jsonrpc\":\"2.0\",\"method\":\"x\"}"))
print(show(rpc.decode("{")))
print(show(rpc.decode("[1]")))
print(rpc.encode(rpc.failure(7, -32602, "bad", { "kind": "params" })))
print(rpc.encode(rpc.failure(8, -32601, "nope")))
print(rpc.encode(rpc.failure(9, -32600, "invalid", nil)))
val built = rpc.errorOf(rpc.failure(10, -32000, "custom", [true, false])) ?? RpcFailure(0, "none")
print(built.code)
print(describe(built))
print(describe(rpc.errorOf(rpc.request(1, "initialize"))))
val notMap: Map[String, Any] = { "error": 5 }
val floatCode: Map[String, Any] = { "error": { "code": 1.5, "message": "x" } }
val stringCode: Map[String, Any] = { "error": { "code": "1", "message": "x" } }
val intMessage: Map[String, Any] = { "error": { "code": 1, "message": 7 } }
val noMessage: Map[String, Any] = { "error": { "code": 1 } }
val noCode: Map[String, Any] = { "error": { "message": "x" } }
print(errorOfRaw(notMap))
print(errorOfRaw(floatCode))
print(errorOfRaw(stringCode))
print(errorOfRaw(intMessage))
print(errorOfRaw(noMessage))
print(errorOfRaw(noCode))
val manual: Map[String, Any] = { "error": { "code": -32001, "message": "manual", "data": [true] } }
val manualFailure = rpc.errorOf(manual) ?? RpcFailure(0, "none")
print(manualFailure.code)
print(describe(manualFailure))
# expect: map:params
# expect: list:3
# expect: int:7
# expect: string:why
# expect: bool:true
