# std.numeric (T1): inteiros e estatísticas; lista vazia => nil.
import std.numeric as numeric

print numeric.gcd(48, 18)
print numeric.lcm(4, 6)
print numeric.isPrime(97)
print numeric.isPrime(1)
print numeric.primes(20)
print numeric.factorial(5)
print numeric.powMod(2, 10, 1000)
print numeric.digitSum(-123)
print numeric.isEven(-4)
print numeric.isOdd(3)
print numeric.sign(-9)
print numeric.mean([1, 2, 3, 4])
print numeric.mean([])
print numeric.median([3, 1, 2])
print numeric.median([4, 1, 3, 2])
print numeric.mode([1, 2, 2, 3])
print numeric.mode([])
print numeric.variance([1, 2, 3, 4])
print numeric.stddev([1, 2, 3, 4])
print numeric.roundTo(3.14159, 2)
print numeric.toBase(255, 16)
print numeric.toBase(-10, 2)
print numeric.fromBase("ff", 16)
print numeric.fromBase("-1010", 2)
print numeric.fromBase("z", 10)
try {
  numeric.factorial(-1)
} except LoxRuntimeError as e {
  print "negativo"
}
try {
  numeric.toBase(10, 1)
} except LoxRuntimeError as e {
  print "base"
}
