# std.paths (T2): caminhos POSIX, manipulação lexical (sem tocar no disco).
import std.paths as paths

print(paths.isAbsolute("/a"))
print(paths.isAbsolute("a"))
print(paths.split("/a//b/./c"))
print(paths.split(""))
print(paths.join("a", "b"))
print(paths.join("a/", "b"))
print(paths.join("/a", "/b"))
print(paths.join("a", ""))
print(repr(paths.basename("/a/b/")))
print(paths.basename("/"))
print(paths.basename(""))
print(paths.basename("a/b.txt"))
print(paths.dirname("/a/b"))
print(paths.dirname("/a"))
print(paths.dirname("/"))
print(paths.dirname("a"))
print(repr(paths.ext("a/b.tar.gz")))
print(repr(paths.ext(".bashrc")))
print(repr(paths.ext("a.")))
print(paths.stem("a/b.tar.gz"))
print(paths.normalize("./a//b/../c/"))
print(paths.normalize("/a/../../b"))
print(paths.normalize("a/../.."))
print(paths.normalize(""))
print(paths.normalize("/"))
print(paths.normalize("a/"))
# expect: true
# expect: false
# expect: ["a", "b", ".", "c"]
# expect: []
# expect: a/b
# expect: a/b
# expect: /b
# expect: a
# expect: "b"
# expect: /
# expect: .
# expect: b.txt
# expect: /a
# expect: /
# expect: /
# expect: .
# expect: "gz"
# expect: ""
# expect: ""
# expect: b.tar
# expect: a/c
# expect: /b
# expect: ..
# expect: .
# expect: /
# expect: a
