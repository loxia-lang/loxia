# std.property: forAll determinístico, shrinking de Int e de lista.
from std.property import forAll, intRange, listOfInt
from std.test import expect

forAll(intRange(0, 5), fn(n: Int) { expect(n >= 0).toBe(true) }, 10, 1)

try {
  forAll(intRange(1, 100), fn(n: Int) { expect(n < 1).toBe(true) }, 3, 7)
} except Exception as error {
  print(error.message)
}

try {
  forAll(listOfInt(intRange(1, 3), 3), fn(xs: List[Int]) {
    expect(len(xs) < 0).toBe(true)
  }, 3, 2)
} except Exception as error {
  print(error.message)
}
# expect: property failed after 1 run(s) (seed 7): expected true, got false; counterexample 15; shrunk to 1
# expect: property failed after 1 run(s) (seed 2): expected true, got false; counterexample [1, 2]; shrunk to []
