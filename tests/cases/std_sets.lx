# std.sets (T2): conjunto sobre Map[Any, Bool], ordem de inserção em toList.
from std.sets import Set, fromList

val letras = fromList(["a", "b", "a", "c"])
print letras.len()
print letras.has("b")
print letras.has("z")
print letras.toList()
print letras.remove("b")
print letras.remove("b")
print letras.toList()
letras.add("d")
print letras.toList()
val outras = fromList(["c", "d", "e"])
print letras.union(outras).toList()
print letras.intersect(outras).toList()
print letras.difference(outras).toList()
val numeros = fromList([3, 1, 3, 2])
print numeros.toList()
print numeros.len()
val flags = fromList([true, false, true])
print flags.toList()
val vazio: Set[String] = Set()
print vazio.len()
print vazio.toList()
try {
  val invalido: Set[Float] = Set()
  invalido.add(1.5)
} except RuntimeError as e {
  print "chave"
}
