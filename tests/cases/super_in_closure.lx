# `super` is lexical in lambdas and local functions (ADR-0022/ADR-0040).
class A {
  fn value() -> Int {
    return 1
  }

  fn name() -> String {
    return "A"
  }
}

class B(A) {
  fn viaLambda() -> fn() -> Int {
    return fn() => super.value()
  }

  fn viaLocal() -> String {
    fn inner() -> String {
      return super.name()
    }
    return inner()
  }
}

val b = B()
print(b.viaLambda()())
print(b.viaLocal())
# expect: 1
# expect: A
