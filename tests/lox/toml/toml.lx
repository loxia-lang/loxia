# SPDX-License-Identifier: MIT OR Apache-2.0
# Spike de TOML em Lox puro (ADR-0118, issue #53).
#
# Subconjunto declarado: tabelas e subtabelas, [[array of tables]], inline tables,
# arrays (inclusive multilinha e vírgula final), strings básicas/literais/multilinha,
# inteiros (decimal, 0x, 0o, 0b, `_`), floats (expoente, `_`), bools e comentários.
# Fora: datas/horas (sem tipo na linguagem) e `inf`/`nan` (irrepresentáveis) — erro com
# linha/coluna, nunca valor silenciosamente errado.
#
# O writer é canônico de propósito: chaves ordenadas e uma folha por linha em dotted
# key (`a.b = 1`), então a saída não depende de ordem, comentário ou espaçamento do
# fonte. Não é o renderizador do `loxia.lock` (spike, não stdlib).

import std.lists as lists

/// Resultado da análise: `ok` distingue sucesso de erro, sem lançar para o chamador.
class TomlParse {
  val ok: Bool
  val value: Any
  val error: String

  fn init(ok: Bool, value: Any, error: String) {
    this.ok = ok
    this.value = value
    this.error = error
  }
}

/// Analisa TOML do subconjunto; erro vem como `"linha:coluna: mensagem"`.
fn parse(text: String) -> TomlParse {
  try {
    val parser = _Parser(text)
    val value = parser.parseRoot()
    return TomlParse(true, value, "")
  } except RuntimeError as error {
    return TomlParse(false, nil, error.message)
  }
}

/// Serializa o modelo em forma canônica (chaves ordenadas, dotted keys).
fn stringify(value: Any) -> String {
  return _renderTable(value as Map[String, Any], "")
}

class _Parser {
  val text: String
  var index: Int
  var line: Int
  var column: Int

  fn init(text: String) {
    this.text = text
    this.index = 0
    this.line = 1
    this.column = 1
  }

  fn _peek() -> Int? {
    if (this.index >= len(this.text)) {
      return nil
    }
    return charCodeAt(this.text, this.index)
  }

  fn _peekAt(offset: Int) -> Int? {
    if (this.index + offset >= len(this.text)) {
      return nil
    }
    return charCodeAt(this.text, this.index + offset)
  }

  fn _advance() -> Int {
    val code = charCodeAt(this.text, this.index)
    this.index = this.index + 1
    if (code == 10) {
      this.line = this.line + 1
      this.column = 1
    } elif (code != 13) {
      this.column = this.column + 1
    }
    return code
  }

  fn _fail(message: String) -> Nil {
    raise RuntimeError("${this.line}:${this.column}: ${message}")
  }

  fn _starts(literal: String) -> Bool {
    if (this.index + len(literal) > len(this.text)) {
      return false
    }
    var offset = 0
    while (offset < len(literal)) {
      if (charCodeAt(this.text, this.index + offset) != charCodeAt(literal, offset)) {
        return false
      }
      offset = offset + 1
    }
    return true
  }

  fn _consume(literal: String) -> Nil {
    if (not this._starts(literal)) {
      this._fail("expected '${literal}'")
    }
    var offset = 0
    while (offset < len(literal)) {
      this._advance()
      offset = offset + 1
    }
  }

  fn _skipSpace() -> Nil {
    var go = true
    while (go) {
      val code = this._peek()
      if (code == nil) {
        go = false
      } elif (code == 32 or code == 9 or code == 10 or code == 13) {
        this._advance()
      } elif (code == 35) {
        var comment = true
        while (comment) {
          val inner = this._peek()
          if (inner == nil or inner == 10) {
            comment = false
          } else {
            this._advance()
          }
        }
      } else {
        go = false
      }
    }
  }

  fn _skipInlineSpace() -> Nil {
    var go = true
    while (go) {
      val code = this._peek()
      if (code == 32 or code == 9) {
        this._advance()
      } else {
        go = false
      }
    }
  }

  fn _endOfLine() -> Nil {
    this._skipInlineSpace()
    val code = this._peek()
    if (code == nil) {
      return
    }
    if (code == 35) {
      var comment = true
      while (comment) {
        val inner = this._peek()
        if (inner == nil or inner == 10) {
          comment = false
        } else {
          this._advance()
        }
      }
      return
    }
    if (code == 10) {
      this._advance()
      return
    }
    if (code == 13) {
      this._advance()
      if (this._peek() == 10) {
        this._advance()
      }
      return
    }
    this._fail("expected end of line")
  }

  fn parseRoot() -> Map[String, Any] {
    val root: Map[String, Any] = {}
    var current = root
    val explicit: Map[String, Bool] = {}
    this._skipSpace()
    while (this._peek() != nil) {
      if (this._starts("[[")) {
        current = this._parseArrayTable(root, explicit)
      } elif (this._starts("[")) {
        current = this._parseTable(root, explicit)
      } else {
        this._parseAssignment(current)
      }
      this._skipSpace()
    }
    return root
  }

  fn _parseTable(root: Map[String, Any], explicit: Map[String, Bool]) -> Map[String, Any] {
    this._consume("[")
    this._skipInlineSpace()
    val path = this._parseKeyPath()
    this._skipInlineSpace()
    this._consume("]")
    this._endOfLine()
    val name = join(path, ".")
    if (explicit.has(name)) {
      this._fail("table '${name}' is already defined")
    }
    explicit[name] = true
    val node = this._walk(root, path, len(path) - 1)
    val leaf = path[len(path) - 1]
    val existing = node.get(leaf)
    if (existing == nil) {
      val child: Map[String, Any] = {}
      node[leaf] = child
      return child
    }
    if (not (existing is Map[String, Any])) {
      this._fail("key '${leaf}' is not a table")
    }
    return existing as Map[String, Any]
  }

  fn _parseArrayTable(root: Map[String, Any], explicit: Map[String, Bool]) -> Map[String, Any] {
    this._consume("[[")
    this._skipInlineSpace()
    val path = this._parseKeyPath()
    this._skipInlineSpace()
    this._consume("]]")
    this._endOfLine()
    val name = join(path, ".")
    if (explicit.has(name)) {
      this._fail("table '${name}' is already defined as a table")
    }
    val node = this._walk(root, path, len(path) - 1)
    val leaf = path[len(path) - 1]
    val existing = node.get(leaf)
    var items: List[Any] = []
    if (existing == nil) {
      node[leaf] = items
    } else {
      if (not (existing is List[Any])) {
        this._fail("key '${leaf}' is not an array of tables")
      }
      items = existing as List[Any]
    }
    val table: Map[String, Any] = {}
    items.push(table)
    return table
  }

  fn _walk(root: Map[String, Any], path: List[String], count: Int) -> Map[String, Any] {
    var node = root
    var index = 0
    while (index < count) {
      val key = path[index]
      val existing = node.get(key)
      if (existing == nil) {
        val child: Map[String, Any] = {}
        node[key] = child
        node = child
      } elif (existing is Map[String, Any]) {
        node = existing as Map[String, Any]
      } else {
        this._fail("key '${key}' is not a table")
      }
      index = index + 1
    }
    return node
  }

  fn _parseAssignment(current: Map[String, Any]) -> Nil {
    val path = this._parseKeyPath()
    this._skipInlineSpace()
    this._consume("=")
    this._skipSpace()
    val value = this._parseValue()
    this._assign(current, path, value)
    this._endOfLine()
  }

  fn _assign(table: Map[String, Any], path: List[String], value: Any) -> Nil {
    val node = this._walk(table, path, len(path) - 1)
    val leaf = path[len(path) - 1]
    if (node.has(leaf)) {
      this._fail("key '${leaf}' is already defined")
    }
    node[leaf] = value
  }

  fn _parseKeyPath() -> List[String] {
    val keys: List[String] = []
    keys.push(this._parseKey())
    this._skipInlineSpace()
    var go = true
    while (go) {
      if (this._peek() == 46) {
        this._advance()
        this._skipInlineSpace()
        keys.push(this._parseKey())
        this._skipInlineSpace()
      } else {
        go = false
      }
    }
    return keys
  }

  fn _parseKey() -> String {
    val code = this._peek()
    if (code == 34) {
      return this._parseBasicString()
    }
    if (code == 39) {
      return this._parseLiteralString()
    }
    var raw = ""
    var go = true
    while (go) {
      val current = this._peek()
      if (current == nil) {
        go = false
      } elif (_isKeyCode(current)) {
        raw = raw + fromCodePoint(this._advance())
      } else {
        go = false
      }
    }
    if (raw == "") {
      this._fail("expected a key")
    }
    return raw
  }

  fn _parseValue() -> Any {
    val code = this._peek()
    if (code == nil) {
      this._fail("expected a value")
    }
    if (code == 34) {
      if (this._starts("\"\"\"")) {
        return this._parseMultilineBasic()
      }
      return this._parseBasicString()
    }
    if (code == 39) {
      if (this._starts("'''")) {
        return this._parseMultilineLiteral()
      }
      return this._parseLiteralString()
    }
    if (code == 91) {
      return this._parseArray()
    }
    if (code == 123) {
      return this._parseInlineTable()
    }
    if (this._starts("true")) {
      this._consume("true")
      return true
    }
    if (this._starts("false")) {
      this._consume("false")
      return false
    }
    if (this._starts("inf") or this._starts("nan")) {
      this._fail("inf/nan are outside the supported TOML subset")
    }
    if (this._looksLikeDate()) {
      this._fail("date/time is outside the supported TOML subset")
    }
    if (code == 43 or code == 45 or (code >= 48 and code <= 57)) {
      return this._parseNumber()
    }
    this._fail("expected a value")
    return nil
  }

  fn _looksLikeDate() -> Bool {
    var index = 0
    while (index < 4) {
      val digit = this._peekAt(index)
      if (digit == nil or digit < 48 or digit > 57) {
        return false
      }
      index = index + 1
    }
    val sep = this._peekAt(4)
    return sep == 45 or sep == 58
  }

  fn _parseNumber() -> Any {
    val start = this.index
    var hasSign = false
    val first = this._peek()
    if (first == 43 or first == 45) {
      hasSign = true
      this._advance()
    }
    val code = this._peek()
    val next = this._peekAt(1)
    if (code == 48 and (next == 120 or next == 111 or next == 98)) {
      if (hasSign) {
        this._fail("hex/octal/binary integers cannot have a sign")
      }
      this._advance()
      var base = 10
      if (next == 120) {
        base = 16
      } elif (next == 111) {
        base = 8
      } else {
        base = 2
      }
      this._advance()
      val digits = this._readIntegerDigits(base)
      return _intFromDigits(digits, base)
    }
    var raw = this._readIntegerDigits(10)
    var isFloat = false
    if (this._peek() == 46) {
      isFloat = true
      this._advance()
      val fraction = this._readIntegerDigits(10)
      raw = raw + "." + fraction
    }
    val exponent = this._peek()
    if (exponent == 101 or exponent == 69) {
      isFloat = true
      this._advance()
      var sign = ""
      val mark = this._peek()
      if (mark == 43 or mark == 45) {
        sign = fromCodePoint(this._advance())
      }
      raw = raw + "e" + sign + this._readIntegerDigits(10)
    }
    if (not isFloat and len(raw) > 1 and charCodeAt(raw, 0) == 48) {
      this._fail("leading zeros are not allowed")
    }
    val sign = "" if not hasSign else fromCodePoint(charCodeAt(this.text, start))
    val text = sign + raw
    if (isFloat) {
      val value = Float.parse(text)
      if (value == nil) {
        this._fail("invalid float")
      }
      return value
    }
    val value = Int.parse(text)
    if (value == nil) {
      this._fail("integer out of range")
    }
    return value
  }

  fn _readIntegerDigits(base: Int) -> String {
    var raw = ""
    var lastUnderscore = false
    var go = true
    while (go) {
      val code = this._peek()
      if (code == 95) {
        if (raw == "" or lastUnderscore) {
          this._fail("misplaced '_' in number")
        }
        lastUnderscore = true
        this._advance()
      } elif (code != nil and _digitValue(code) >= 0 and _digitValue(code) < base) {
        raw = raw + fromCodePoint(this._advance())
        lastUnderscore = false
      } else {
        go = false
      }
    }
    if (raw == "") {
      this._fail("expected a digit")
    }
    if (lastUnderscore) {
      this._fail("misplaced '_' in number")
    }
    return raw
  }

  fn _parseArray() -> List[Any] {
    this._consume("[")
    val items: List[Any] = []
    var go = true
    while (go) {
      this._skipSpace()
      val code = this._peek()
      if (code == 93) {
        this._advance()
        go = false
      } elif (code == nil) {
        this._fail("unterminated array")
      } else {
        items.push(this._parseValue())
        this._skipSpace()
        val after = this._peek()
        if (after == 44) {
          this._advance()
        } elif (after == 93) {
          this._advance()
          go = false
        } else {
          this._fail("expected ',' or ']' in array")
        }
      }
    }
    return items
  }

  fn _parseInlineTable() -> Map[String, Any] {
    this._consume("{")
    val table: Map[String, Any] = {}
    this._skipInlineSpace()
    if (this._peek() == 125) {
      this._advance()
      return table
    }
    var go = true
    while (go) {
      this._skipInlineSpace()
      val code = this._peek()
      if (code == nil or code == 10 or code == 13) {
        this._fail("newline inside an inline table")
      }
      val path = this._parseKeyPath()
      this._consume("=")
      this._skipInlineSpace()
      val value = this._parseValue()
      this._assign(table, path, value)
      this._skipInlineSpace()
      val after = this._peek()
      if (after == 44) {
        this._advance()
      } elif (after == 125) {
        this._advance()
        go = false
      } else {
        this._fail("expected ',' or '}' in inline table")
      }
    }
    return table
  }

  fn _parseBasicString() -> String {
    this._consume("\"")
    var out = ""
    var go = true
    while (go) {
      val code = this._peek()
      if (code == nil or code == 10) {
        this._fail("unterminated string")
      }
      if (code == 34) {
        this._advance()
        go = false
      } elif (code == 92) {
        this._advance()
        out = out + this._parseEscape()
      } else {
        out = out + fromCodePoint(this._advance())
      }
    }
    return out
  }

  fn _parseLiteralString() -> String {
    this._consume("'")
    var out = ""
    var go = true
    while (go) {
      val code = this._peek()
      if (code == nil or code == 10) {
        this._fail("unterminated string")
      }
      if (code == 39) {
        this._advance()
        go = false
      } else {
        out = out + fromCodePoint(this._advance())
      }
    }
    return out
  }

  fn _parseMultilineBasic() -> String {
    this._consume("\"\"\"")
    this._trimFirstNewline()
    var out = ""
    var go = true
    while (go) {
      val code = this._peek()
      if (code == nil) {
        this._fail("unterminated multi-line string")
      }
      if (code == 34 and this._starts("\"\"\"")) {
        this._consume("\"\"\"")
        go = false
      } elif (code == 92) {
        this._advance()
        val next = this._peek()
        if (next == 32 or next == 9 or next == 10 or next == 13) {
          this._skipContinuation()
        } else {
          out = out + this._parseEscape()
        }
      } elif (code == 13) {
        this._advance()
        if (this._peek() == 10) {
          this._advance()
        }
        out = out + "\n"
      } else {
        out = out + fromCodePoint(this._advance())
      }
    }
    return out
  }

  fn _skipContinuation() -> Nil {
    var go = true
    while (go) {
      val code = this._peek()
      if (code == 32 or code == 9 or code == 10 or code == 13) {
        this._advance()
      } else {
        go = false
      }
    }
  }

  fn _parseMultilineLiteral() -> String {
    this._consume("'''")
    this._trimFirstNewline()
    var out = ""
    var go = true
    while (go) {
      val code = this._peek()
      if (code == nil) {
        this._fail("unterminated multi-line string")
      }
      if (code == 39 and this._starts("'''")) {
        this._consume("'''")
        go = false
      } elif (code == 13) {
        this._advance()
        if (this._peek() == 10) {
          this._advance()
        }
        out = out + "\n"
      } else {
        out = out + fromCodePoint(this._advance())
      }
    }
    return out
  }

  fn _trimFirstNewline() -> Nil {
    if (this._peek() == 13) {
      this._advance()
      if (this._peek() == 10) {
        this._advance()
      }
    } elif (this._peek() == 10) {
      this._advance()
    }
  }

  fn _parseEscape() -> String {
    val code = this._peek()
    if (code == nil) {
      this._fail("unterminated escape")
    }
    this._advance()
    if (code == 98) {
      return fromCodePoint(8)
    }
    if (code == 116) {
      return fromCodePoint(9)
    }
    if (code == 110) {
      return fromCodePoint(10)
    }
    if (code == 102) {
      return fromCodePoint(12)
    }
    if (code == 114) {
      return fromCodePoint(13)
    }
    if (code == 34) {
      return "\""
    }
    if (code == 92) {
      return "\\"
    }
    if (code == 117) {
      return this._unicodeEscape(4)
    }
    if (code == 85) {
      return this._unicodeEscape(8)
    }
    this._fail("invalid escape")
    return ""
  }

  fn _unicodeEscape(size: Int) -> String {
    var value = 0
    var count = 0
    while (count < size) {
      val code = this._peek()
      if (code == nil) {
        this._fail("unterminated unicode escape")
      }
      val digit = _digitValue(code)
      if (digit < 0 or digit > 15) {
        this._fail("invalid unicode escape")
      }
      value = value * 16 + digit
      this._advance()
      count = count + 1
    }
    if (value > 1114111 or (value >= 55296 and value <= 57343)) {
      this._fail("invalid unicode scalar")
    }
    return fromCodePoint(value)
  }
}

fn _isKeyCode(code: Int) -> Bool {
  return (code >= 97 and code <= 122) or
    (code >= 65 and code <= 90) or
    (code >= 48 and code <= 57) or
    code == 95 or
    code == 45
}

fn _digitValue(code: Int) -> Int {
  if (code >= 48 and code <= 57) {
    return code - 48
  }
  if (code >= 97 and code <= 102) {
    return code - 87
  }
  if (code >= 65 and code <= 70) {
    return code - 55
  }
  return -1
}

fn _intFromDigits(digits: String, base: Int) -> Int {
  var value = 0
  var index = 0
  while (index < len(digits)) {
    value = value * base + _digitValue(charCodeAt(digits, index))
    index = index + 1
  }
  return value
}

fn _renderTable(table: Map[String, Any], prefix: String) -> String {
  var out = ""
  val keys = lists.sortNatural(table.keys())
  for key in keys {
    val value = table[key]
    val segment = _renderKey(key)
    val name = segment if prefix == "" else "${prefix}.${segment}"
    out = out + _renderEntry(name, value)
  }
  return out
}

fn _renderEntry(name: String, value: Any) -> String {
  if (value is Map[String, Any]) {
    val table = value as Map[String, Any]
    if (len(table) == 0) {
      return "${name} = {}\n"
    }
    return _renderTable(table, name)
  }
  return "${name} = ${_renderValue(value)}\n"
}

fn _renderValue(value: Any) -> String {
  if (value is String) {
    return _quote(value as String)
  }
  if (value is Bool) {
    return str(value)
  }
  if (value is Int) {
    return str(value)
  }
  if (value is Float) {
    return str(value)
  }
  if (value is List[Any]) {
    val items = value as List[Any]
    var parts: List[String] = []
    for item in items {
      parts.push(_renderValue(item))
    }
    return "[" + join(parts, ", ") + "]"
  }
  if (value is Map[String, Any]) {
    return _renderInline(value as Map[String, Any])
  }
  return str(value)
}

fn _renderInline(table: Map[String, Any]) -> String {
  val keys = lists.sortNatural(table.keys())
  var parts: List[String] = []
  for key in keys {
    parts.push("${_renderKey(key)} = ${_renderValue(table[key])}")
  }
  return "{" + join(parts, ", ") + "}"
}

fn _renderKey(key: String) -> String {
  if (len(key) == 0) {
    return _quote(key)
  }
  var index = 0
  while (index < len(key)) {
    if (not _isKeyCode(charCodeAt(key, index))) {
      return _quote(key)
    }
    index = index + 1
  }
  return key
}

fn _quote(text: String) -> String {
  var out = "\""
  var index = 0
  while (index < len(text)) {
    val code = charCodeAt(text, index)
    if (code == 34) {
      out = out + "\\\""
    } elif (code == 92) {
      out = out + "\\\\"
    } elif (code == 10) {
      out = out + "\\n"
    } elif (code == 13) {
      out = out + "\\r"
    } elif (code == 9) {
      out = out + "\\t"
    } elif (code == 8) {
      out = out + "\\b"
    } elif (code == 12) {
      out = out + "\\f"
    } elif (code < 32 or code == 127) {
      out = out + "\\u" + _hex4(code)
    } else {
      out = out + fromCodePoint(code)
    }
    index = index + 1
  }
  return out + "\""
}

fn _hex4(value: Int) -> String {
  val a = value // 4096
  val b = (value // 256) % 16
  val c = (value // 16) % 16
  val d = value % 16
  return fromCodePoint(_hexDigit(a)) +
    fromCodePoint(_hexDigit(b)) +
    fromCodePoint(_hexDigit(c)) +
    fromCodePoint(_hexDigit(d))
}

fn _hexDigit(value: Int) -> Int {
  if (value < 10) {
    return 48 + value
  }
  return 55 + value
}
