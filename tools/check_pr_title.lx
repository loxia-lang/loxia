# SPDX-License-Identifier: MIT OR Apache-2.0
# check_pr_title — valida o título de PR (Conventional Commits) em Loxia.
#
# Dogfood do módulo `regex` (ADR-0131). Lê o título de `args()[0]` ou de `PR_TITLE`;
# exit 0 quando válido, 1 com a razão no stderr. O check em Python (`tools/
# check_pr_title.py`) continua no CI até este rodar verde por um release.

import regex

import std.strings as strings

val PATTERN = "^([a-z]+)(\\([a-z0-9][a-z0-9-]*\\))?!?: (\\S.*)$"

# Mesma ordem de `tools/conventional.py` (sorted(TYPES)) para a mensagem bater.
val TYPES = [
  "build",
  "chore",
  "ci",
  "docs",
  "feat",
  "fix",
  "perf",
  "refactor",
  "revert",
  "style",
  "test",
]

# `str.strip()` do Python remove Unicode White_Space; `strings.trim` só ASCII.
fn is_space(code: Int) -> Bool {
  if (code >= 9 and code <= 13) {
    return true
  }
  if (code >= 28 and code <= 32) {
    return true
  }
  if (code == 133 or code == 160 or code == 5760) {
    return true
  }
  if (code >= 8192 and code <= 8202) {
    return true
  }
  if (code == 8232 or code == 8233 or code == 8239 or code == 8287) {
    return true
  }
  return code == 12288
}

fn trim_unicode(text: String) -> String {
  var start = 0
  while (start < len(text) and is_space(charCodeAt(text, start))) {
    start = start + 1
  }
  var end = len(text)
  while (end > start and is_space(charCodeAt(text, end - 1))) {
    end = end - 1
  }
  return substr(text, start, end)
}

fn first_line(message: String) -> String {
  for line in strings.lines(message) {
    val trimmed = trim_unicode(line)
    if (len(trimmed) > 0 and not strings.startsWith(trimmed, "#")) {
      return trimmed
    }
  }
  return ""
}

fn known_type(kind: String) -> Bool {
  for candidate in TYPES {
    if (candidate == kind) {
      return true
    }
  }
  return false
}

fn allowed_types() -> String {
  var out = ""
  for candidate in TYPES {
    if (len(out) > 0) {
      out = out + ", "
    }
    out = out + candidate
  }
  return out
}

fn validate(title: String) -> String {
  if (len(title) == 0) {
    return "empty message"
  }
  for prefix in ["Merge ", "fixup! ", "squash! ", "amend! "] {
    if (strings.startsWith(title, prefix)) {
      return ""
    }
  }
  val compiled = regex.tryCompile(PATTERN)
  if (compiled == nil) {
    return "invalid pattern"
  }
  val found = compiled.find(title)
  if (found == nil) {
    return "expected '<type>(<scope>): <subject>' (scope and ! are optional)"
  }
  val kind = found.groups[0]
  if (kind == nil) {
    return "empty type"
  }
  if (not known_type(kind)) {
    return "unknown type '" + kind + "'; allowed: " + allowed_types()
  }
  val raw_subject = found.groups[2]
  if (raw_subject == nil) {
    return "empty subject"
  }
  val subject = trim_unicode(raw_subject)
  if (len(subject) == 0) {
    return "empty subject"
  }
  if (strings.endsWith(subject, ".")) {
    return "subject must not end with a period"
  }
  if (len(title) > 100) {
    return "header is " + str(len(title)) + " characters; keep it under 100"
  }
  return ""
}

fn main() -> Int {
  val arguments = args()
  var raw = os.getenv("PR_TITLE") ?? ""
  if (len(arguments) > 0) {
    raw = arguments[0]
  }
  val error = validate(first_line(raw))
  if (len(error) == 0) {
    return 0
  }
  io.writeErr("pr-title: " + error + "\n")
  io.writeErr("see CONTRIBUTING.md § Commit messages\n")
  return 1
}

os.exit(main())
